component SigilDesignIntake {
  goal {
    Route every requested change through a proportionate material-decision
    assessment before semantic authoring or implementation begins.
  }

  interface {
    DesignIntake {
      assess(request, evidence) returns mechanical, conversation-required, or
      context-insufficient with a compact decision inventory and routing basis

      conversation-required identifies every unresolved material decision and routes
      it to SigilDesignConversation before authoring or implementation
    }
  }
}

expand SigilDesignIntake {
  logic {
    DesignIntake {
      Inspect the requested boundary and inventory choices affecting purpose,
      ownership, public behavior, lifecycle, failure handling, permissions,
      persistence, compatibility, architecture, verification, or future consistency.

      Classify a change as mechanical only when inspection establishes that it
      introduces no material decision. Record the evidence supporting that bypass.

      Return conversation-required when a material decision is unresolved. Do not
      author Sigil or implementation until SigilDesignConversation resolves it.

      Return context-insufficient when the required boundary, evidence, or decision
      cannot be classified reliably. Report the missing context and do not author
      speculative Sigil or implementation.
    }
  }

  constraints {
    DesignIntake {
      A decision is material when leaving it unresolved could change a contract,
      ownership, lifecycle, failure behavior, permissions, persistent data,
      compatibility, binding architecture, acceptance criteria, or future
      consistency.

      An outcome request, implementation request, successful check, or compiler
      result never bypasses DesignIntake.

      Read-only explanation, diagnosis, and status work record no mutation route.
    }
  }

  decisions {
    UniversalMaterialDecisionIntake {
      Decision: Require compact material-decision routing for every requested change
      before semantic authoring or implementation.

      Scope: Governs host routing for all change requests; excludes read-only work
      and proven mechanical changes with no material decision.

      Trade-offs: Simple changes incur a brief explicit classification, while
      material choices cannot be silently assumed.

      Design issues addressed: Optional conversation routing allowed agents to begin
      authoring after noticing a change request without first recognizing its
      unresolved design choices.

      Consequences: Material uncertainty enters DesignConversation and insufficient
      context stops authoring until the missing evidence is available.
    }
  }

  cases {
    DesignIntake {
      A requested change with an unresolved choice that could affect a contract,
      ownership, lifecycle, risk, compatibility, verification, or future consistency
      returns conversation-required.

      A change proven to introduce no material decision returns mechanical.

      A request whose relevant boundary or evidence cannot be established returns
      context-insufficient and does not begin authoring.
    }
  }
}
