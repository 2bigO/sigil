@spec/language.sigil import { SigilLanguage, SigilWorkspaceConfig, SigilModuleIndex }
@packages/cli import { SigilCli }
@packages/core import { SigilImplementationOwnership }
@integrations/skills/sigil/design-conversation.sigil import { SigilDesignConversation }
@integrations/skills/sigil/external-guidance-evidence.sigil import { ExternalGuidanceEvidence }

component SigilSkill {
  goal {
    Provide coding-agent hosts with one reusable workflow for designing, reviewing, reconciling, and implementing software through approved Sigil contracts.

    Keep ambiguity resolution, semantic judgment, evidence classification, standards and modularity review, and human approval outside deterministic core and CLI behavior.
  }

  interface {
    SkillPackage {
      SKILL.md is the portable workflow entrypoint

      VERSION owns the skill artifact version

      compatibility.json declares compatible CLI, core, and language versions

      references are loaded progressively when their procedures apply

      host installation locations and adapters do not alter workflow semantics
    }

    WorkspaceBootstrap {
      identifies the target repository and its configuration state before semantic workflow selection

      handles configured workspaces, unconfigured repositories with existing Sigil, and unconfigured repositories without Sigil

      reports a missing ConfigFile without mutation and initializes only when ReviewGate for workspace-initialization returns ready
    }

    WorkflowSelection {
      selects Greenfield design, Brownfield adoption, or established-Sigil review from implementation and Sigil evidence after workspace bootstrap

      validates ConfigFile and tool compatibility before relying on workspace semantics
    }

    EvidenceReview {
      separates observed behavior, documented intent, user-confirmed intent, unresolved ambiguity, suspected accidental behavior, and external guidance
    }

    SemanticReadinessReview {
      distinguishes deterministic structural validation from model-assisted semantic, architectural, and design review

      assesses exact Sigil meaning, coherence, ownership, behavior, lifecycle, risk, and architecture before concept grouping or glossary extraction

      permits enrichment workflows only when no unresolved material semantic problem remains
    }

    StandardsReview {
      assesses applicable authoritative guidance and classifies findings before proposing informed semantic changes
    }

    ModularityReview {
      assesses cohesion, interface size, coupling, dependency direction, state ownership, and reasons to change without assigning a numeric score
    }

    ImplementationCoverage {
      discovers coherent implementation responsibilities

      classifies each material concern as an independent component, an expand owned by an existing component, or an omitted trivial mechanic

      reports coverage before implementation begins
    }

    ImplementationOwnershipWorkflow {
      records explicit implementation comments that link language entrypoint definitions or agent-facing Markdown to a governing component or concept using SigilImplementationOwnership

      supports forward linking during approved code generation and reconciliation linking from inspected Sigil and existing implementation
    }

    ImplementationGovernance {
      requires governing Sigil and implementation coverage to be inspected before any implementation mutation

      uses ReviewGate with implementation over the validated written Sigil and exact implementation scope before implementation begins

      treats deterministic CLI validation as structural only and never as semantic approval

      uses ReviewGate with sigil-change when a request changes the observable contract of a different component or surface

      applies regardless of language, format, subsystem, or artifact classification
    }

    ConceptIdentifierWorkflow {
      discovers reusable identities across the complete component, matching expands, accessible imports, and relevant direct consumers

      checks deterministic concept diagnostics before proposing identifiers

      uses one proposal-only concept-identifier subagent when subagents are available
    }

    SemanticLineDiscipline {
      preserves one distinct idea per semantic line and separates distinct prose-level ideas with blank lines
    }

    DesignConversation {
      resolves incomplete material design decisions and reviews coherent written contracts for improvements before exact Sigil synthesis

      uses exploration, improvement, and correction modes within one conversation

      investigates suspected findings before classifying them as correction

      requires each confirmed material problem to be resolved before Sigil synthesis or implementation
    }

    DecisionRationaleWorkflow {
      records material selected choices and the rationale needed for future review, maintenance, and agent sessions

      applies a consistent authoring convention while preserving the language's free-form decisions syntax

      uses automatically projected direct-dependency decisions as scoped rationale without treating them as imported public contract

      audits every new or changed material selected choice for durable rationale before ReviewGate for sigil-change can return ready

      reports each choice as covered by a decisions occurrence or intentionally omitted with concrete evidence
    }

    GlossaryWorkflow {
      validates deterministic glossary diagnostics before semantic review

      extracts candidate domain terms and conflicting usage from Sigil prose

      separates deterministic glossary projection inspection from mandatory model-assisted candidate extraction

      reports candidate evidence or an explicit evidence-based no-material-candidate result before Sigil review

      classifies every Sigil session as glossary extraction required, extraction deferred, or deterministic inspection only

      reports the selected glossary status and its evidence instead of silently skipping candidate identification

      presents exact reviewed GlossaryFile proposals without automatically changing authority

      requires post-write glossary inspection and candidate extraction after approved Sigil is created or semantically edited

      carries relevant reviewed terminology into implementation context

      includes a glossary eval fixture covering extraction, ambiguity, context placement, and approval
    }

    ReviewGate {
      ReviewGate(action, scope, changeSet, evidence) returns blocked, review-required, or ready

      evaluates mutation approval through one reusable workflow

      keeps approval bound to the exact action, scope, and change set

      treats delegated proposals, validation, readiness reviews, coverage, and diagnostics as evidence rather than approval
    }
  }
}

expand SigilSkill {
  state {
    WorkspaceBootstrap {
      Configuration state is configured, unconfigured with existing Sigil, unconfigured without Sigil, invalid, or outside the selected target.
    }

    WorkflowSelection {
      Greenfield applies when no existing implementation constrains the selected behavior or component.

      Brownfield applies when relevant implementation exists but Sigil coverage is absent, partial, ambiguous, or suspected to have drifted.

      Established-Sigil review applies when the selected boundary already has credible contract coverage.
    }

    EvidenceReview {
      Evidence is classified as observed behavior, documented intent, user-confirmed intent, unresolved ambiguity, suspected accidental behavior, or external guidance.
    }

    SemanticReadinessReview {
      Semantic readiness is unassessed, correction required, or appears aligned within the stated scope.
    }

    StandardsReview {
      A researched finding is compatible guidance, a potential conflict, a definite conflict, unverifiable guidance, or non-applicable.
    }

    DesignConversation {
      Mode is exploration, improvement, or correction.
    }

    ReviewGate {
      Action is sigil-change, glossary-change, workspace-initialization, or implementation.

      Result is blocked, review-required, or ready.
    }

    ImplementationGovernance {
      Implementation coverage is unassessed, partial, or established.
    }
  }

  logic {
    WorkspaceBootstrap {
      Resolve the selected repository root and any eligible ancestor workspace before interpreting Sigil sources.

      When a valid ConfigFile governs the target, validate that configured workspace without initialization.

      When no ConfigFile governs the target, inventory existing Sigil paths and report the repository as unconfigured without mutation.

      Invoke initialization only when ReviewGate for workspace-initialization returns ready.

      When an existing ConfigFile is invalid, preserve it and stop with diagnostics.

      Stop before semantic workflow selection when compatibility validation fails.
    }

    WorkflowSelection {
      Complete WorkspaceBootstrap, then inspect relevant implementation and Sigil evidence.

      Select GreenfieldWorkflow, BrownfieldWorkflow, or established-Sigil review from that evidence.
    }

    DesignConversation {
      Build the relevant component picture before entering SigilDesignConversation.

      Invoke SigilDesignConversation only for explicit design, review, or improvement work or when a material unresolved decision or finding requires user judgment.

      Investigate suspected findings without automatically entering correction or blocking unrelated work.

      Enter correction mode only for a confirmed material semantic, architectural, or design problem.

      Recheck affected related-Sigil coherence before proposal synthesis.
    }

    DecisionRationaleWorkflow {
      Use one concise PascalCase concept block for each material decision.

      Record Decision and Scope for every authored material decision.

      Scope states the governed boundary and important exclusions without attempting to enumerate every current dependent.

      Record Assumptions, Trade-offs, Design issues addressed, Discarded alternatives, Consequences, and Revisit when when materially applicable.

      Omit an inapplicable rationale label instead of adding filler.

      Reuse an accessible concept identifier when decisions concern the same semantic idea.

      Scope states the local boundary of a contextual decision occurrence; concept reuse does not make a decision transitively binding.

      Keep the binding selected outcome in constraints and use decisions to explain why it was selected.

      Before presenting an exact semantic proposal, inventory every new or changed selected choice expressed across goal, interface, state, logic, constraints, and cases.

      Treat a choice as material when future review, maintenance, or implementation cannot safely reconstruct why it was selected or what alternatives it excludes.

      Map each material selected choice to a matching decisions occurrence that preserves its durable rationale.

      When the binding outcome is confirmed but its decision record is missing, include the exact decision record in the semantic proposal.

      When the governing rationale is unresolved or conflicts with evidence, return to DesignConversation in the applicable mode before proposing the decision record.

      Repeat the decision-rationale coverage audit after writing approved Sigil and before ReviewGate for implementation can return ready.
    }

    EvidenceReview {
      Inspect relevant Sigil, implementation, tests, documentation, manifests, and executable configuration.

      Keep every evidence category distinct in analysis and proposals.

      Report contradictions instead of silently choosing one source as intent.
    }

    SemanticReadinessReview {
      After deterministic workspace validation completes without error diagnostics, review the exact ungrouped Sigil for semantic, architectural, and design problems.

      When evidence suggests a possible material problem, investigate and classify it before declaring correction required.

      When a confirmed material problem is found, enter DesignConversation in correction mode and do not begin concept grouping or glossary candidate extraction.

      Mark the selected scope as appears aligned only when no unresolved confirmed material problem or materially unsafe uncertainty remains.

      After approved concept grouping changes, rerun deterministic validation and semantic-readiness review before glossary candidate extraction.

      When concept grouping exposes or introduces material ambiguity, return to DesignConversation in the applicable mode.
    }

    GlossaryWorkflow {
      Collect candidate terms with their source occurrences and resolved bounded contexts.

      Separate accepted glossary authority from model-assisted candidate extraction.

      When GlossaryFile exists, perform deterministic glossary inspection and explicitly classify whether model-assisted extraction applies.

      Begin model-assisted glossary candidate extraction only after the post-write and post-grouping SemanticReadinessReview appears aligned for the selected scope.

      When concept grouping is unnecessary, the post-write SemanticReadinessReview directly gates glossary candidate extraction.

      After every approved Sigil write or semantic edit, run deterministic glossary and workspace inspection, then independently perform model-assisted extraction from the changed semantic lines regardless of diagnostic count or GlossaryFile presence.

      Require model-assisted extraction after an approved semantic Sigil write or edit, when the user requests vocabulary review, or when terminology ambiguity materially affects the selected scope.

      For an explicit vocabulary review or material ambiguity without changed Sigil, extract from the selected loaded Sigil scope only after SemanticReadinessReview appears aligned.

      When semantic readiness is unassessed or correction required, report extraction as deferred and name the blocking review state.

      When a session changes only implementation or performs read-only work without a vocabulary-review trigger, report deterministic inspection only and explain that no semantic Sigil lines entered candidate extraction.

      Conclude that no material candidate exists only after inspecting the changed semantic lines, relevant surrounding occurrences, and accepted glossary entries.

      Before completing a triggered session, report candidates with evidence or an evidence-based no-material-candidate result.

      Report conflicting definitions, aliases, scope placement, and normative-contract drift.

      Present exact JSON additions, replacements, or removals to ReviewGate with glossary-change before mutation.

      After approved Sigil is written or semantically edited, run workspace and glossary validation and inspect changed semantic lines for candidate terms.

      Block review and implementation when undefined or conflicting terminology could materially alter behavior, ownership, state, APIs, or implementation.

      After ReviewGate for glossary-change returns ready, write only the accepted proposal, rerun glossary and workspace validation, and return to ReviewGate for implementation.

      Before implementation, obtain context through sigil context and make its scoped glossary projection available to the coding agent.
    }

    StandardsReview {
      Use ApplicabilityAssessment and EvidencePacket from ExternalGuidanceEvidence on every Sigil review and acquire required or recommended authoritative research.

      Verify the currency and environment match of evidence created during design conversation before reusing it.

      Classify each current finding and present compatible changes as exact proposed semantic lines.

      Preserve current Sigil and request a decision when guidance potentially or definitely conflicts.
    }

    ModularityReview {
      Review component responsibility, dependent-facing interface, imports, collected expands, state ownership, dependency direction, and reasons to change.

      Propose boundary changes when one component owns unrelated responsibilities or multiple components compete for one responsibility.
    }

    ImplementationCoverage {
      Identify coherent responsibilities, stable dependent-facing interfaces, meaningful state, and material decisions in the selected implementation boundary.

      Choose component, expand, or omission from semantic ownership rather than file, class, function, endpoint, or visual-element counts.

      Present a coverage map containing each material concern, owner, dependents, selected Sigil form, and owning location.
    }

    ImplementationOwnershipWorkflow {
      During approved implementation, derive governing component and concept identities from the implementation coverage map and add ownership comments beside the implementation entrypoints being written.

      Use the implementation language's entrypoint syntax to associate annotations with classes, functions, methods, interfaces, structs, or equivalent stable definitions.

      Use one single-line comment for one source annotation and one multiline comment for multiple source annotations.

      Use HTML comments for annotations in agent-facing Markdown.

      After implementation, verify each comment's Sigil path, component, optional concept, and entrypoint association.

      Return mismatched or stale annotations to reconciliation rather than silently rewriting Sigil.

      For reconciliation, inspect the selected component and expands together with code, tests, and agent-facing workflow Markdown, then present evidence-backed candidate implementation comments to ReviewGate with implementation.
    }

    ImplementationGovernance {
      Inspect governing Sigil before every implementation mutation.

      Classify every material implementation concern as established, partial, or missing.

      Use ReviewGate with sigil-change when implementation requires new or changed governing Sigil.

      After writing approved Sigil, run deterministic validation and report the written result without creating another approval gate.

      Before implementation, use ReviewGate with implementation over the validated written Sigil and exact implementation scope.

      Stop implementation and return to sigil-change when implementation exposes a missing material decision.
    }

    ConceptIdentifierWorkflow {
      Begin concept reuse discovery, grouping, and identifier proposals only after SemanticReadinessReview appears aligned for the selected scope.

      Inspect the affected section, every other section of the component, and every matching expand for the same semantic idea.

      Inspect accessible imported public concepts before creating a local identity.

      Inspect direct importers for relevant use cases and established terminology.

      Traverse transitive importers only when a concept is re-exposed or namespace ambiguity must be assessed.

      Classify each affected region as local reuse, imported public reuse, or a new identity.

      Give the proposal-only subagent the affected regions, complete component and expands, local occurrences, imported candidates, consumer evidence, and graph paths.

      After approved grouping changes, return to SemanticReadinessReview before glossary candidate extraction.
    }

    GreenfieldWorkflow {
      Begin with the problem, intended users or callers, outcomes, boundaries, non-responsibilities, and important constraints.

      Resolve material product, contract, ownership, lifecycle, architecture, risk, and verification decisions through DesignConversation.

      Establish the smallest coherent component boundary and draft goal and interface before operational detail.

      Run evidence, standards, modularity, implementation-coverage, and concept-identifier review as applicable.

      Synthesize exact Sigil, obtain ReviewGate readiness for sigil-change, write and validate it, then report the result before implementation review.
    }

    BrownfieldWorkflow {
      Use WorkspaceBootstrap and stop boundary inspection while the repository remains unconfigured.

      Validate WorkspaceBoundary and inspect the root plus every declared member.

      Gather boundary documentation, manifests, executable configuration, and entrypoints.

      Confirm each configured boundary's responsibility, intended outcome, users or systems, and external interaction surface.

      Propose and review an ordinary summary component in each boundary's ModuleIndexFile.

      After ReviewGate returns ready for the boundary-summary sigil-change and the summary is written and validated, narrow to the requested coherent task boundary and reconcile its evidence.

      Present exact task components, expands, locations, and imports to ReviewGate with sigil-change, then write only when ready and validate the result.
    }

    ReviewGate {
      Collect applicable evidence from workspace bootstrap, semantic review, decision-rationale coverage, glossary inspection, implementation coverage, deterministic validation, and delegated analysis.

      Return blocked when a material conflict, unresolved binding decision, or required evidence prevents the action.

      Return review-required when the action is coherent but the exact action, scope, and change set lack explicit user approval.

      Return ready only when the user approved the exact action, scope, and change set and no material evidence has changed.

      Invalidate ready when the action, scope, change set, or material evidence changes.

      Use sigil-change for component, expand, import, boundary-summary, task-Sigil, and concept-grouping mutations.

      Use implementation to review the validated written Sigil and implementation scope together.

      Use glossary-change for reviewed GlossaryFile mutations.

      Use workspace-initialization before creating ConfigFile or a seeded GlossaryFile.
    }
  }

  constraints {
    SkillPackage {
      The skill workflow remains semantically host-neutral.

      Each host adapter may define discovery and presentation mechanics but does not redefine ReviewGate or approval authority.

      Skill artifact version ownership is independent from language and distributable tool versions.
    }

    WorkflowSelection {
      Deterministic facts come from compatible CLI and core behavior.

      Model-assisted judgment, ambiguity resolution, and approval remain host-workflow responsibilities.
    }

    WorkspaceBootstrap {
      Existing Sigil sources without ConfigFile are unconfigured evidence, not an established workspace and not a compatibility failure until bootstrap is attempted.

      Initialization never overwrites an existing ConfigFile or semantically rewrites existing Sigil sources.

      Workflow classification does not determine whether a missing ConfigFile may be initialized.

      Review and diagnosis do not initialize an unconfigured repository.

      Workspace initialization requires ReviewGate approval for the exact selected repository root and files that may be created.
    }

    EvidenceReview {
      Code is evidence of current behavior, not proof of desired behavior or rationale.

      Suspected accidental behavior does not become a contract without user confirmation.
    }

    SemanticReadinessReview {
      Successful CLI validation does not establish semantic readiness.

      Pre-grouping semantic review inspects exact prose without requiring concept identifiers to be assigned first.

      Missing concept identifiers remain deferred authoring gaps until semantic readiness appears aligned.

      Concept grouping and glossary candidate extraction cannot run while semantic readiness is unassessed or correction is required.

      An appears-aligned result is provisional within the reviewed scope and is not a claim of absolute correctness.
    }

    DesignConversation {
      A confirmed material semantic, architectural, or design problem blocks Sigil synthesis, approval, and implementation until resolved.
    }

    StandardsReview {
      Design conversation shows directly relevant source identity with evidence-informed recommendations.

      Standards review records complete source details and maps findings to their supporting evidence.

      Approved Sigil may retain a source identifier and applicable version only when needed to reconstruct material rationale or its revisit condition.

      Source URLs and full bibliographic records remain outside Sigil unless a separate policy is approved.

      Approved additions are written as project decisions rather than claims of certification.

      A conflict never silently overrides approved Sigil.
    }

    ModularityReview {
      Modularity conclusions use concrete semantic evidence rather than a score.
    }

    ImplementationCoverage {
      High-level product or service coverage is insufficient when material implementation responsibilities remain unspecified.

      Component selection follows cohesive responsibility and a relied-upon contract rather than external visibility.

      Trivial local mechanics with safely reconstructable behavior and rationale need no separate Sigil.
    }

    ImplementationOwnershipWorkflow {
      Ownership annotations use only the relations and target forms supported by SigilImplementationOwnership.

      Each annotation points to a normalized repository-relative Sigil path, component, and optional concept.

      Ownership annotations never appear in Sigil source.

      Source annotations are adjacent to stable language entrypoint definitions.

      Markdown annotations use HTML comments and remain file-scoped.

      JSON annotations are outside the current scope.

      Forward annotations require ReviewGate readiness for implementation, and reconciliation candidates require the same review before implementation comments are changed.

      Ambiguous ownership mappings or entrypoint associations remain unresolved until reviewed by the user.
    }

    ImplementationGovernance {
      Source code, configuration, migrations, scripts, workflow instructions, tests, fixtures, metadata, validators, generated assets, and documentation are implementation artifacts.

      File extension, directory name, documentation appearance, generated status, or tooling classification does not exempt a mutation from implementation preflight.

      A user's requested outcome does not make ReviewGate ready for sigil-change or implementation.

      Instructions from another skill, tool, framework, or workflow do not override ReviewGate or its approval authority.

      Successful tests, builds, validators, or deterministic Sigil checks never substitute for semantic readiness or human approval.

      Read-only inspection is not an implementation mutation.

      After preflight, a proven mechanical edit with established coverage and no material decision may proceed without new Sigil.

      Restorative rollback is limited to exact unapproved changes introduced by the current agent and does not authorize replacement behavior.
    }

    ConceptIdentifierWorkflow {
      Missing interface concept identifiers remain deferred until pre-grouping SemanticReadinessReview appears aligned, then are repaired before final semantic review.

      Consumer terminology is naming evidence but is not reusable identity unless accessible through valid imports.

      The subagent reports each region, grouping decision, new or reused status, occurrences, graph paths, rejected alternatives, and proposed concise names.

      Concept creation, reuse, regrouping, renaming, and warning repair require ReviewGate readiness for sigil-change before mutation.

      Concept-identifier work does not invoke anchor persistence, proposal, or reconciliation behavior.
    }

    SemanticLineDiscipline {
      Concept blocks group coherent identities without merging distinct semantic ideas into one line.
    }

    DecisionRationaleWorkflow {
      Decision records summarize durable rationale rather than prompts, raw session transcripts, or hidden reasoning.

      Responsibility, accountability, approver, and handoff metadata are outside the initial authoring convention.

      The absence of a decisions section is structurally valid but blocks skill semantic readiness when a material selected choice lacks durable rationale.

      A material selected choice cannot make ReviewGate ready for sigil-change or implementation without decision-rationale coverage.

      A trivial, mechanically derived, or safely reconstructable choice does not require a filler decision record.

      Successful CLI validation does not establish decision-rationale coverage.
    }

    GlossaryWorkflow {
      Candidate extraction never becomes authoritative without explicit human approval.

      Normative approved Sigil governs when GlossaryFile conflicts with a component contract.

      Unknown vocabulary remains a semantic-review candidate rather than a deterministic core diagnostic.

      Zero diagnostics from sigil glossary establishes only that the deterministic glossary projection is valid; it never proves the absence of unknown candidate vocabulary, conflicting meanings, or incorrect scope.

      A host does not report that no glossary changes are needed until model-assisted candidate extraction is complete and its evidence is recorded.

      Ordinary unambiguous vocabulary does not block review merely because it is absent from GlossaryFile.

      Material terminology ambiguity blocks implementation until its reviewed definition, aliases, and workspace or bounded-context scope are approved.

      Coding agents use scoped glossary context to interpret requests and Sigil without treating glossary definitions as behavioral contracts.

      Markdown extraction remains deferred from the initial fixture and workflow.
    }

    GreenfieldWorkflow {
      Major product, architecture, persistence, authorization, deployment, and lifecycle decisions are not invented silently.

      Implementation does not begin until ReviewGate for implementation is ready for the validated Sigil and exact implementation scope.
    }

    BrownfieldWorkflow {
      ConfigFile initialization never overwrites an existing configuration.

      Configured boundary summaries precede task-specific modeling.

      Additional summary boundaries are not inferred from package manifests or directory structure.

      Existing user changes and unrelated dirty-worktree content are preserved.
    }

    WorkspaceMutationBoundary {
      CLI and language-server operations do not semantically edit .sigil sources.

      ConfigFile initialization is the narrow CLI mutation exception.

      Semantic Sigil mutation belongs to the approved agent workflow.
    }

    ReviewGate {
      All explicit mutation approval flows through ReviewGate.

      Validation, semantic readiness, coverage, evidence, delegated analysis, and conflict classification do not independently grant approval.

      Approval for one action or scope does not authorize another.

      Review and diagnosis perform no repository mutation.

      A blocked result cannot be bypassed by successful deterministic validation.

      A ready result remains valid only for its approved action, scope, and change set.
    }
  }

  decisions {
    DesignConversation {
      Decision: Route material design work through imported SigilDesignConversation while keeping conversation modes and evidence-acquisition mechanics owned by their providing components.

      Scope: Governs SigilSkill workflow dispatch; excludes the internal mechanics of SigilDesignConversation and ExternalGuidanceEvidence.

      Trade-offs: The dispatcher relies on imported component contracts instead of restating their complete behavior.

      Design issues addressed: Duplicated correction and applicability behavior created competing authorities and semantic drift.

      Consequences: SigilSkill selects the workflow, SigilDesignConversation owns user-facing design resolution, and ExternalGuidanceEvidence owns research applicability.

      Revisit when: These responsibilities are intentionally recombined into one component.
    }

    StandardsReview {
      Decision: Consume shared ExternalGuidanceEvidence while retaining standards review authority over finding classification and gate consequences.

      Scope: Governs standards-aware semantic review; excludes evidence acquisition mechanics and design-conversation recommendation policy.

      Trade-offs: Reused evidence must receive a separate currency and applicability verification.

      Design issues addressed: Shared evidence should not allow its producer or an earlier design conversation to determine approval consequences.

      Consequences: Research remains reusable while standards review independently owns conflicts, compliance language, and blocking outcomes.

      Revisit when: Evidence classification and workflow approval become one intentionally governed component.
    }

    DecisionRationaleWorkflow {
      Decision: Require a decision-rationale coverage audit before ReviewGate can return ready for sigil-change and again after approved Sigil is written.

      Scope: Governs new or changed material selected choices in semantic Sigil proposals; excludes trivial, mechanically derived, and safely reconstructable choices.

      Trade-offs: Every material proposal requires an additional coverage review and may require more semantic lines.

      Design issues addressed: Material workflow choices previously reached approval because decision authoring described record format without requiring coverage.

      Consequences: Missing rationale blocks semantic readiness, and exact decision records must be included in the approved proposal.

      Revisit when: Deterministic tooling can identify decision-rationale coverage without treating model judgment as language validity.
    }

    SemanticReadinessReview {
      Decision: Treat CLI validation as structural only and require skill-assisted semantic readiness before concept grouping or glossary candidate extraction, followed by another semantic review after grouping.

      Scope: Governs Sigil skill review ordering; excludes deterministic glossary inspection and core CLI validity semantics.

      Trade-offs: Two semantic reviews may be required when concept grouping changes written Sigil.

      Design issues addressed: Structurally valid Sigil may still contain unresolved semantic, architectural, or design problems.

      Consequences: Correction-required Sigil blocks enrichment, approval, and implementation until resolved.

      Revisit when: Deterministic tooling provides reviewed semantic validation with equivalent human decision authority.
    }

    GlossaryWorkflow {
      Decision: Make glossary routing and completion status explicit in every Sigil session while keeping model-assisted extraction scope-triggered and semantic-readiness-gated.

      Scope: Governs sessions using the Sigil skill when a GlossaryFile exists, approved Sigil is written or edited, vocabulary review is requested, or material terminology ambiguity is identified; excludes unrelated implementation prose and deferred Markdown extraction.

      Trade-offs: Every Sigil session gains a small deterministic inspection and reporting cost, while implementation-only sessions avoid repeated full candidate extraction.

      Design issues addressed: Silent routing and removal of glossary language from the host prompt made correctly deferred or inapplicable extraction appear not to run.

      Discarded alternatives: Extracting candidates from the entire workspace in every session would create repeated noise and could bypass semantic-readiness ordering.

      Consequences: Triggered extraction cannot disappear silently, deferred extraction names its blocker, and inspection-only sessions explain why candidate identification did not apply.

      Revisit when: Deterministic tooling can identify candidate vocabulary or the host exposes workflow-stage status directly.
    }

    ReviewGate {
      Decision: Use one reusable ReviewGate for every mutation approval while keeping checks, evidence, and blockers outside approval authority.

      Scope: Governs Sigil changes, glossary changes, workspace initialization, and implementation; excludes read-only inspection and deterministic validation.

      Trade-offs: Different actions reuse one mechanism but still require separately scoped approval.

      Design issues addressed: Multiple gate names duplicated authority, obscured workflow state, and created unnecessary approval stages.

      Discarded alternatives: Separate proposal, pre-edit, semantic-review, task-Sigil, boundary-summary, written-Sigil, glossary-review, and implementation gates were rejected as overlapping representations of the same approval responsibility.

      Consequences: Sigil changes receive one approval, and implementation receives one later approval that reviews the validated written Sigil together with implementation scope.

      Revisit when: A mutation type requires materially different approval authority rather than different evidence.
    }

    WorkspaceBootstrap {
      Decision: Keep review and diagnosis bootstrap non-mutating and require ReviewGate approval before workspace initialization.

      Scope: Governs repositories without an eligible ConfigFile; excludes validation of already configured workspaces.

      Trade-offs: An unconfigured repository requires one explicit initialization approval before semantic workspace interpretation.

      Design issues addressed: Automatic initialization contradicted the read-only review contract.

      Consequences: Missing configuration is reported without mutation, and initialization creates files only after scoped approval.

      Revisit when: The host provides an explicitly authorized initialization mode before the Sigil workflow begins.
    }

    ImplementationGovernance {
      Decision: Require Sigil coverage inspection before every implementation mutation.

      Scope: Governs all implementation artifacts in a Sigil-governed workspace regardless of language, format, subsystem, or artifact classification; excludes read-only inspection and exact restorative rollback.

      Trade-offs: Every implementation mutation incurs contract-discovery overhead before editing, even when preflight later determines that no Sigil change is required.

      Design issues addressed: Agents may otherwise classify tests, configuration, workflow documents, metadata, validators, or other non-source artifacts as outside implementation and bypass Sigil-first development.

      Discarded alternatives: Deciding whether an edit changes behavior before preflight preserves the same subjective loophole that caused the gate bypass.

      Consequences: Artifact classification cannot authorize mutation; implementation readiness follows inspected coverage and ReviewGate readiness for the exact implementation scope.

      Revisit when: The host can deterministically map every repository mutation to governing Sigil and enforce the approval states.
    }

    ImplementationOwnershipWorkflow {
      Decision: Support forward and reconciliation ownership links through implementation comments that point to governing Sigil components and concepts.

      Scope: Governs skill-authored ownership comments in source code, tests, and agent-facing workflow Markdown; excludes annotations inside Sigil, JSON, ordinary documentation, non-text artifacts, and unreviewed reconciliation mutation.

      Trade-offs: Implementation-local comments keep links visible beside changing entrypoints, but agents must follow language-specific comment and definition syntax.

      Design issues addressed: Ownership links otherwise depend on manual follow-up, can become detached from their symbols, or can couple Sigil contracts to implementation locations.

      Consequences: Generated entrypoints carry links to governing Sigil, existing repositories gain a controlled reconciliation path, and Sigil source remains free of implementation annotations.

      Revisit when: A supported language cannot provide stable comment-to-entrypoint association or another artifact format needs annotation support.
    }
  }

  cases {
    WorkspaceBootstrap {
      An unconfigured repository is inventoried and reported without creating files during review or diagnosis.

      Approved workspace-initialization creates only the reviewed ConfigFile and optional seeded GlossaryFile.

      An invalid existing ConfigFile is reported without replacement.
    }

    WorkflowSelection {
      A component with credible existing Sigil uses established-Sigil review unless evidence shows drift.
    }

    EvidenceReview {
      Conflicting code, tests, and documentation are reported for user decision rather than silently reconciled.
    }

    SemanticReadinessReview {
      Structurally valid Sigil with contradictory state ownership enters DesignConversation in correction mode before concept grouping or glossary extraction.

      Ungrouped Sigil that appears semantically aligned proceeds to concept grouping, then receives another semantic-readiness review before glossary extraction.
    }

    DesignConversation {
      A suspected ownership problem is investigated before it is classified as correction.

      A confirmed ownership conflict enters correction mode instead of continuing to unrelated design questions.
    }

    DecisionRationaleWorkflow {
      An importer may reuse a provider's public concept in decisions to explain local rationale while Scope confines that decision to the importer.

      A proposal that changes validation and enrichment ordering includes a matching decision record explaining why the order was selected.

      A proposal with no material selected choice reports the inspected changes and why no decision record is required.

      A written material constraint without matching durable rationale returns to proposal review before implementation.
    }

    GlossaryWorkflow {
      Two inconsistent uses of one candidate term produce a review question rather than an inferred definition.

      A zero-diagnostic glossary projection followed by a changed semantic line containing an unknown project-specific term still produces candidate evidence and, when material, an exact glossary proposal.

      When model-assisted inspection finds no material candidate, the host records the changed lines and surrounding evidence inspected before proceeding to Sigil review.

      An approved Sigil edit with no material terminology candidate proceeds to ReviewGate for implementation after workspace and glossary validation.

      A correction-required session reports glossary extraction as deferred and names the unresolved semantic blocker.

      An implementation-only session with no semantic Sigil edit reports deterministic inspection only rather than implying candidate extraction completed.

      An explicit vocabulary-review request extracts candidates from the selected semantically aligned Sigil scope even when no Sigil line changed.

      An approved candidate is written to its selected workspace or bounded-context scope, validated, and returned to ReviewGate for implementation.

      A coding handoff includes only glossary terms relevant to the selected component or file and related sources.
    }

    StandardsReview {
      Unavailable compliance-critical guidance blocks implementation while low-risk unverifiable guidance is reported for explicit acceptance.
    }

    ModularityReview {
      A component with unrelated lifecycle and storage responsibilities is reconsidered as multiple owners rather than marked with a low score.
    }

    ImplementationCoverage {
      A stable Promise-like caller API can be a component, a material retry algorithm can be an expand, and a trivial formatter can be omitted.
    }

    ImplementationOwnershipWorkflow {
      A new TypeScript function with one ownership link receives one adjacent line comment during approved implementation.

      One entrypoint with multiple ownership links receives one multiline comment containing each annotation.

      An agent-facing Markdown workflow uses an HTML comment and resolves as a file-level target.

      A brownfield reconciliation scans relevant Sigil, code, tests, and workflow instructions and proposes only implementation comments supported by inspected evidence.

      JSON remains unchanged during ownership annotation.
    }

    ImplementationGovernance {
      A request to modify any implementation artifact triggers Sigil and coverage inspection before the first edit.

      Configuration, tests, validators, metadata, workflow documentation, and generated artifacts receive the same preflight as source code.

      A high-level request to fix or build something does not make ReviewGate ready for sigil-change or implementation.

      A mechanical edit may omit new Sigil only after preflight establishes complete coverage and no material decision.

      Passing tests or validation after an implementation-first edit does not legitimize the bypass.

      An agent that detects its own unapproved mutations reports them and performs only the user-requested exact rollback before returning to ReviewGate with sigil-change.
    }

    ConceptIdentifierWorkflow {
      The same idea in an interface and matching expand reuses one collective identifier.

      An accessible imported public identity is reused instead of creating a synonym.

      Two accessible imported identities with the same name are reported for resolution rather than qualified with dotted syntax.
    }

    GreenfieldWorkflow {
      An undecided public behavior discovered during implementation returns to ReviewGate with sigil-change.
    }

    BrownfieldWorkflow {
      A workspace without ConfigFile is reported as unconfigured before boundary inspection and initialized only when ReviewGate for workspace-initialization returns ready.
    }

    WorkspaceMutationBoundary {
      A read-only validation command reports diagnostics without rewriting Sigil sources.
    }

    ReviewGate {
      A boundary-summary proposal, task-Sigil proposal, and concept-grouping proposal all use sigil-change rather than separate named gates.

      Written Sigil is validated and reported without a separate written-Sigil approval gate.

      Requested implementation uses implementation to review the validated written Sigil and implementation scope together.

      A delegated proposal remains evidence and cannot produce ready without user approval.

      A material validation or semantic problem produces blocked even when deterministic commands complete successfully.
    }
  }
}
