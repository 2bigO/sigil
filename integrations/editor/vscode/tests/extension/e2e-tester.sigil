component SigilVsCodeE2ETester {
  goal {
    Verify the VS Code integration through an isolated extension host.

    Exercise language and preview behavior at the VS Code API boundary without depending on a user's global editor state.
  }

  interface {
    ExtensionHostTest {
      launches the extension development host with the Sigil integration and a
      controlled file-backed workspace

      invokes contributed language and preview commands through the VS Code API
    }
  }

  constraints {
    TestRunner {
      uses @vscode/test-electron to launch a separate VS Code extension host

      disables unrelated extensions and supplies a temporary test workspace or
      controlled fixture state

      does not mutate the repository's user workspace or depend on global VS Code
      settings
    }
  }

  cases {
    ExtensionHostLifecycle {
      the tester starts the extension host, discovers the Sigil extension, waits
      until hover and definition providers respond for the fixture, and exits with a
      passing result after all assertions

      an extension activation, readiness, or assertion failure exits the test run
      with the failing assertion and captured host output
    }

    LanguageFeatures {
      opening a Sigil fixture provides a hover and definition through the VS Code
      language-feature command API
    }

    DocumentPreview {
      invoking Open Preview through the command API opens a Markdown preview for the
      whole active Sigil document
    }

    TestIsolation {
      unrelated installed extensions do not determine the language and preview
      assertions
    }
  }
}
