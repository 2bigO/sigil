@spec/language.sigil import { SigilLanguage, SigilWorkspaceConfig }

component SigilCore {
  goal {
    Provide the deterministic semantic engine shared by Sigil command-line, language-server, editor, and agent integrations.

    Compose source interpretation, configuration, workspace loading, relationship resolution, graph construction, projections, and diagnostics without owning host interaction or semantic judgment.
  }

  interface {
    SourceInterpretation {
      parseSigilDocument(filePath, source, options) returns a recovered source document and structural diagnostics
    }

    ConfigurationInterpretation {
      parseSigilConfig(source, filePath?) returns validated workspace configuration or diagnostics
    }

    WorkspaceProcessing {
      discoverSigilWorkspace(filesystem, options) returns the selected configured workspace boundary

      loadSigilWorkspace(filesystem, options) returns selected source documents, declared member roots, and accumulated diagnostics
    }

    WorkspaceResolution {
      resolveSigilWorkspace(workspace) returns resolved imports, components, collective expansions, concept namespaces, graph relationships, and diagnostics
    }

    SemanticProjections {
      componentContracts(resolvedWorkspace) returns public component contract views

      conceptNamespaceFor(resolvedWorkspace, componentName) returns the resolved concept namespace in that component's context

      collectedExpansionFor(resolvedWorkspace, componentName) returns every collected expansion for that component
    }

    CoreData {
      exports immutable typed source, configuration, diagnostic, workspace, resolution, graph, and projection data
    }

    RecoverableResults {
      returns partial deterministic results with stable diagnostics when malformed Sigil or configuration permits recovery

      propagates required host filesystem failures instead of translating them into Sigil diagnostics
    }
  }
}

expand SigilCore {
  constraints {
    PackageVersionOwnership {
      packages/core/deno.json owns the @qoherent/sigil-core artifact version.

      The package contract does not duplicate its manifest-owned version literal.
    }

    DeterministicCore {
      Core computes structural facts and performs no model-assisted semantic judgment.

      Core does not own CLI arguments, LSP transport, editor APIs, agent-host behavior, approval decisions, or user-interface presentation.
    }

    DependencyDirection {
      Internal stages depend only in the declared source-to-resolution-to-projection direction and do not create cyclic ownership.

      Host integrations consume core semantics instead of implementing independent Sigil parsers, workspace rules, resolvers, or concept interpretation.
    }

    RecoverableResults {
      Source and configuration problems remain diagnostics when partial deterministic results are meaningful.

      Host filesystem and runtime failures propagate to the caller.
    }
  }

  cases {
    WorkspaceResolution {
      Resolving a loaded workspace returns imports, components, collective expansions, concept namespaces, graph relationships, and accumulated diagnostics.
    }

    DeterministicCore {
      CLI and LSP callers operating on the same loaded workspace receive results derived from the same core stages.
    }

    RecoverableResults {
      Recoverable malformed Sigil returns partial source and workspace models with stable diagnostics.

      An unreadable required file rejects the operation rather than becoming an unresolved-import diagnostic.
    }
  }
}
