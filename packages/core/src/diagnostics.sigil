@packages/core/src/model.sigil import { SigilSemanticModel }

component SigilDiagnostics {
  goal {
    Construct stable machine-readable diagnostics for recoverable Sigil source, configuration, workspace, and resolution problems.

    Keep diagnostic creation independent from host failures and higher core stages.
  }

  interface {
    DiagnosticConstruction {
      diagnostic(code, message, options?) returns a SigilDiagnostic

      severity defaults to error when omitted

      options may provide severity, file path, and source range
    }

    DiagnosticCode {
      diagnostic codes are stable identifiers that consumers may interpret without parsing messages
    }
  }
}

expand SigilDiagnostics {
  constraints {
    DiagnosticConstruction {
      Diagnostic construction depends only on SigilSemanticModel data.

      Parsing, configuration, workspace, and resolution problems use diagnostics when partial results remain meaningful.

      Host filesystem and runtime failures are not converted into Sigil diagnostics.
    }

    DiagnosticCode {
      Every diagnostic code has one stable severity-bearing machine-readable representation.
    }
  }

  cases {
    DiagnosticCode {
      An unknown section produces a source-ranged SIGIL_UNKNOWN_SECTION diagnostic.

      An unsupported configured language version produces SIGIL_UNSUPPORTED_VERSION.

      An imports-only #module.sigil produces SIGIL_MODULE_WITHOUT_COMPONENT.

      A contiguous ungrouped interface region produces warning SIGIL_MISSING_CONCEPT_IDENTIFIER.

      An identifier outside [A-Za-z][A-Za-z0-9_-]* produces error SIGIL_INVALID_CONCEPT_IDENTIFIER.

      An empty concept block produces error SIGIL_EMPTY_CONCEPT_BLOCK.

      A nested concept block produces error SIGIL_NESTED_CONCEPT_BLOCK.

      Two different accessible concepts with identifiers equal without regard to case produce error SIGIL_AMBIGUOUS_CONCEPT_IDENTIFIER.

      A valid identifier that is not PascalCase or contains a hyphen or underscore produces informational SIGIL_CONCEPT_IDENTIFIER_STYLE.
    }

    DiagnosticConstruction {
      Omitting severity constructs an error diagnostic.

      A filesystem permission failure rejects the host operation instead of producing a Sigil diagnostic.
    }
  }
}
