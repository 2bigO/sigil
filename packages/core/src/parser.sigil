@spec/language.sigil import { SigilLanguage, SigilModuleIndex }
@packages/core/src/model.sigil import { SigilSemanticModel }
@packages/core/src/diagnostics.sigil import { SigilDiagnostics }

component SigilParser {
  goal {
    Interpret one versioned Sigil source into a source-faithful partial document.

    Preserve useful declarations, concepts, semantic lines, and ranges whenever malformed structure permits deterministic recovery.
  }

  interface {
    SourceDocument {
      parseSigilDocument(filePath, source, options) returns ParseResult

      options.sigilVersion is required and must equal SupportedLanguageVersion
    }

    ParseResult {
      ParseResult contains a recovered SigilDocument and structural diagnostics
    }
  }
}

expand SigilParser {
  logic {
    SourceDocument {
      Parse top-level import, component, and expand forms.

      Parse sections and flat concept blocks while preserving identifiers and ranges.

      Associate each semantic line inside a concept block with that identifier.

      Preserve non-empty free semantic lines outside concept blocks.

      Recover unclosed forms and sections when practical.
    }

    ComponentContract {
      Diagnose components missing goal or interface.
    }

    ModuleIndexContents {
      Diagnose a ModuleIndexFile that contains no local component.
    }

    ConceptIdentity {
      Report one warning for each contiguous ungrouped interface region.

      Reject invalid identifiers, empty concept blocks, and nested concept blocks.
    }

    LanguageVersion {
      Reject an unsupported configured language version before interpreting declarations.
    }
  }

  constraints {
    SourceDocument {
      SigilParser performs no filesystem access or workspace resolution.

      Warnings preserve a usable partial document and do not make parsing fail.
    }

    ConceptIdentity {
      Concept body content remains free-form except for structural brace tracking.
    }

    DiagnosticConstruction {
      Structural findings are created through SigilDiagnostics.
    }
  }

  cases {
    ParseResult {
      Valid source returns recovered declarations and semantic lines without error diagnostics.

      An unclosed component returns its recoverable content with a source-ranged structural diagnostic.
    }

    ComponentContract {
      A component missing goal or interface remains in the partial document with required-section diagnostics.
    }

    ConceptIdentity {
      A contiguous ungrouped interface region produces one SIGIL_MISSING_CONCEPT_IDENTIFIER warning.

      A concept block with several lines preserves one identity and every semantic line.

      Ungrouped non-interface content produces no missing-identifier warning.

      Empty and nested concept blocks are invalid.
    }

    ModuleIndexContents {
      An imports-only ModuleIndexFile produces SIGIL_MODULE_WITHOUT_COMPONENT.
    }

    LanguageVersion {
      An unsupported version returns an empty partial document with SIGIL_UNSUPPORTED_VERSION.
    }
  }
}
