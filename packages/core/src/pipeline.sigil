@packages/core/src/model.sigil import { SigilSemanticModel }
@packages/core/src/diagnostics.sigil import { SigilDiagnostics }
@packages/core/src/filesystem.sigil import { SigilFileSystem }
@packages/core/src/parser.sigil import { SigilParser }
@packages/core/src/workspace.sigil import { SigilWorkspaceLoader }
@packages/core/src/resolver.sigil import { SigilResolver }
@packages/core/src/graph.sigil import { SigilGraphBuilder }
@packages/core/src/projections.sigil import { SigilProjections }

expand SigilCore {
  logic {
    SourceInterpretation {
      parseSigilDocument delegates versioned source interpretation to SigilParser.
    }

    WorkspaceProcessing {
      discoverSigilWorkspace and loadSigilWorkspace delegate configured discovery and loading to SigilWorkspaceLoader.
    }

    WorkspaceResolution {
      resolveSigilWorkspace obtains relationship data from SigilResolver and graph data from SigilGraphBuilder, then returns ResolvedSigilWorkspace.
    }

    SemanticProjections {
      componentContracts, conceptNamespaceFor, and collectedExpansionFor delegate structured views to SigilProjections.
    }
  }

  constraints {
    DependencyDirection {
      SigilSemanticModel defines shared immutable data.

      SigilDiagnostics and SigilFileSystem depend only on shared model and trivial path mechanics.

      SigilParser depends on model and diagnostics.

      SigilWorkspaceLoader depends on configuration, filesystem, parser, model, and diagnostics.

      SigilResolver depends on loaded workspace data, model, and diagnostics.

      SigilGraphBuilder depends on resolved relationships and model data.

      SigilProjections depends on resolved workspace and graph-backed data.

      The facade composes these stages without reversing their ownership.
    }
  }

  cases {
    WorkspaceResolution {
      A loaded workspace resolves through relationship and graph stages into one ResolvedSigilWorkspace.
    }

    SemanticProjections {
      Existing CLI and LSP consumers obtain contract, concept, and expansion views without accessing internal stage data directly.
    }
  }
}
