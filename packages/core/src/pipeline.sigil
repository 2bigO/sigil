@packages/core/src/model import { SigilSemanticModel }
@packages/core/src/diagnostics.sigil import { SigilDiagnostics }
@packages/core/src/resolver.sigil import { SigilResolver }
@packages/core/src/graph.sigil import { SigilGraphBuilder }
@packages/core/src/glossary.sigil import { SigilGlossaryEngine }

component SigilWorkspaceResolutionPipeline {
  goal {
    Compose resolved workspace relationship, graph, and glossary data into one
    deterministic result for core consumers.

    Keep stage ordering, result assembly, and diagnostic deduplication separate
    from the individual resolver, graph, and glossary owners.
  }

  interface {
    WorkspaceResolution {
      resolveSigilWorkspace(workspace) accepts one already loaded SigilWorkspace and
      returns one ResolvedSigilWorkspace containing relationship data, graph data,
      glossary data, and merged diagnostics

      Malformed loaded documents and glossary data remain represented by partial
      results and diagnostics when the underlying stages can recover.

      The operation performs no filesystem access or configuration discovery;
      required dependency and runtime failures propagate to the caller.

      Each call is stateless and completes one pipeline operation without retaining a
      lifecycle or session.
    }
  }
}

expand SigilWorkspaceResolutionPipeline {
  logic {
    WorkspaceResolutionPipeline {
      Resolve the loaded workspace through SigilResolver to obtain relationship data
      and diagnostics.

      Derive the workspace glossary projection through SigilGlossaryEngine, then
      construct the relationship graph through SigilGraphBuilder.

      Return one ResolvedSigilWorkspace containing resolution data, graph data,
      glossary data, and merged diagnostics.

      SigilSemanticModel owns the immutable result shapes and SigilDiagnostics owns
      the diagnostic records consumed by the merge.

      Merge resolution and glossary diagnostics in source-stage order while removing
      exact duplicate diagnostic records.
    }
  }

  constraints {
    WorkspaceResolutionPipeline {
      The pipeline consumes an already loaded SigilWorkspace and performs no source
      parsing, configuration discovery, or filesystem access.

      SigilResolver owns relationship interpretation, SigilGraphBuilder owns graph
      construction, and SigilGlossaryEngine owns glossary projection.

      The pipeline owns only stage ordering, result assembly, and exact diagnostic
      deduplication.
    }
  }

  cases {
    WorkspaceResolutionPipeline {
      A loaded workspace returns one resolved workspace containing relationship,
      graph, and glossary projections.

      Resolution and glossary diagnostics are combined without duplicate records.
    }
  }
}
