@packages/core/src/model/language.sigil import { SigilLanguageModel }
@packages/core/src/model/configuration.sigil import { SigilConfigurationModel }
@packages/core/src/model/diagnostics.sigil import { SigilDiagnosticModel }
@packages/core/src/model/source.sigil import { SigilSourceModel }
@packages/core/src/model/glossary.sigil import { SigilGlossaryModel }
@packages/core/src/model/ownership.sigil import { SigilImplementationOwnershipModel }
@packages/core/src/model/workspace.sigil import { SigilWorkspaceModel }
@packages/core/src/model/resolution.sigil import { SigilResolutionModel }
@packages/core/src/model/graph.sigil import { SigilGraphModel }
@packages/core/src/model/retrieval.sigil import { SigilRetrievalModel }

component SigilSemanticModel {
  goal {
    Assemble the intentionally explicit namespace of immutable deterministic core
    model contracts without owning their domain behavior or data definitions.
  }

  interface {
    ModelNamespace {
      SigilSemanticModel provides SigilLanguageModel, SigilConfigurationModel,
      SigilDiagnosticModel, SigilSourceModel, SigilGlossaryModel,
      SigilImplementationOwnershipModel, SigilWorkspaceModel, SigilResolutionModel,
      SigilGraphModel, and SigilRetrievalModel through explicit domain modules.
    }
  }
}

expand SigilSemanticModel {
  constraints {
    DomainModelAssembly {
      The module index assembles domain model contracts only; each domain component
      owns its independently evolving immutable data shapes.
    }
  }

  decisions {
    DomainModelDecomposition {
      Decision: Split the former aggregate model contract into domain components and
      require consumers to adopt explicit domain-module imports.

      Scope: Governs core model contract ownership and import paths; excludes
      operational parsing, loading, resolution, graph, and retrieval behavior.

      Trade-offs: Consumers migrate imports and cross-domain types use explicit
      dependencies rather than relying on one aggregate module.

      Design issues addressed: Independently evolving model domains no longer
      converge on one ownership boundary.

      Consequences: Model changes remain localized while the module index exposes the
      intentional namespace assembly.
    }
  }
}
