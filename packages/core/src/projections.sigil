@packages/core/src/model.sigil import { SigilSemanticModel }
@packages/core/src/resolver.sigil import { SigilResolver }
@packages/core/src/graph.sigil import { SigilGraphBuilder }

component SigilProjections {
  goal {
    Provide small structured views over resolved Sigil data for CLI, LSP, renderer, and agent integrations.

    Prevent hosts from reinterpreting raw declarations to obtain component, concept, and expansion views.
  }

  interface {
    ContractProjection {
      componentContracts(resolvedWorkspace) returns one ComponentContractView per resolved component

      ComponentContractView exposes component name, source path, goal lines, interface lines, ungrouped interface lines, and interface concept blocks
    }

    ConceptNamespaceProjection {
      conceptNamespaceFor(resolvedWorkspace, componentName) returns that component's contextual resolved concept namespace or undefined
    }

    ExpansionProjection {
      collectedExpansionFor(resolvedWorkspace, componentName) returns every matching expansion or undefined
    }
  }
}

expand SigilProjections {
  logic {
    ContractProjection {
      Preserve resolved component order.

      Return goal and interface semantic text without adding interpretation.

      Preserve concept identifiers, grouped lines, source ranges, and ungrouped interface lines.
    }

    ConceptNamespaceProjection {
      Return the namespace built by SigilResolver without changing identity, visibility, origin, or contextual occurrences.
    }

    ExpansionProjection {
      Return every collected expand source for the selected component.
    }
  }

  constraints {
    DependencyDirection {
      Projections consume resolved workspace and graph-backed data without filesystem access, parsing, resolution, Markdown rendering, or agent ranking.
    }

    RecoverableResults {
      Missing goal or interface sections project as empty collections while diagnostics remain in the resolved workspace.
    }
  }

  cases {
    ContractProjection {
      A resolved component projects its public contract with declaration path and source-aware concept blocks.
    }

    ConceptNamespaceProjection {
      An imported concept retains its origin and contextual importer occurrences.

      Selecting a provider excludes lines contributed only by its consumers.
    }

    ExpansionProjection {
      A component with expands in multiple files returns every expansion.

      An unknown component returns undefined.
    }
  }
}
