@packages/core/src/model.sigil import { SigilSemanticModel }
@packages/core/src/resolver.sigil import { SigilResolver }
@packages/core/src/graph.sigil import { SigilGraphBuilder }

component SigilProjections {
  goal {
    Provide small structured views over resolved Sigil data for CLI, LSP, renderer, and agent integrations.

    Prevent hosts from reinterpreting raw declarations to obtain component, concept, and expansion views.
  }

  interface {
    ContractProjection {
      componentContracts(resolvedWorkspace) returns one ComponentContractView per resolved component

      ComponentContractView exposes component name, source path, goal lines, interface lines, ungrouped interface lines, and interface concept blocks
    }

    ConceptNamespaceProjection {
      conceptNamespaceFor(resolvedWorkspace, componentName) returns that component's contextual resolved concept namespace or undefined
    }

    ExpansionProjection {
      collectedExpansionFor(resolvedWorkspace, componentName) returns every matching expansion or undefined
    }

    AgentDependencyContext {
      agentDependencyContextFor(resolvedWorkspace, componentName) returns the selected component, its collected expansions, direct dependency public contracts, direct dependency decision sections, and related source paths, or undefined
    }
  }
}

expand SigilProjections {
  logic {
    ContractProjection {
      Preserve resolved component order.

      Return goal and interface semantic text without adding interpretation.

      Preserve concept identifiers, grouped lines, source ranges, and ungrouped interface lines.
    }

    ConceptNamespaceProjection {
      Return the namespace built by SigilResolver without changing identity, visibility, origin, contextual occurrences, references, or source order.
    }

    ExpansionProjection {
      Return every collected expand source for the selected component.
    }

    AgentDependencyContext {
      Resolve direct dependencies from imports declared by the selected component source.

      Preserve deterministic import order and include each resolved dependency once.

      Project each direct dependency's public goal and interface.

      Include only decisions sections from each direct dependency's collected expansions.
    }
  }

  constraints {
    DependencyDirection {
      Projections consume resolved workspace and graph-backed data without filesystem access, parsing, resolution, Markdown rendering, or agent ranking.
    }

    RecoverableResults {
      Missing goal or interface sections project as empty collections while diagnostics remain in the resolved workspace.
    }

    AgentDependencyContext {
      Agent dependency context is out-of-band inspection and does not change language-level import visibility.

      Dependency decisions provide rationale and do not become dependent-facing or transitively binding.

      Transitive dependency decisions and direct dependency state, logic, constraints, cases, and private concepts remain excluded by default.
    }
  }

  decisions {
    AgentDependencyContext {
      Decision: Automatically include durable decisions from direct dependencies in agent context.

      Context: Agents can use additional rationale to preserve architectural intent, but ordinary dependents require only stable public contracts.

      Scope: Applies to agent context projection for direct dependencies and excludes language-level imports, transitive dependencies, and other private operational sections.

      Trade-offs: Uses additional context and may include irrelevant rationale in exchange for reducing missed architectural intent and extra discovery calls.

      Revisit when: Typical dependency decision sets become too large or evidence shows that automatic rationale reduces agent accuracy.
    }
  }

  cases {
    ContractProjection {
      A resolved component projects its public contract with declaration path and source-aware concept blocks.
    }

    ConceptNamespaceProjection {
      An imported concept retains its origin and contextual importer occurrences.

      Selecting a provider excludes lines contributed only by its consumers.
    }

    ExpansionProjection {
      A component with expands in multiple files returns every expansion.

      An unknown component returns undefined.
    }

    AgentDependencyContext {
      Selecting a component includes the public contracts and decision sections of its direct dependencies.

      A dependency's decisions remain labeled as rationale rather than part of its public contract.

      A transitive dependency contributes no decisions unless selected explicitly.
    }
  }
}
