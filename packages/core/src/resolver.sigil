@spec/language.sigil import { SigilLanguage, SigilModuleIndex }
@packages/core/src/model.sigil import { SigilSemanticModel }
@packages/core/src/diagnostics.sigil import { SigilDiagnostics }

component SigilResolver {
  goal {
    Resolve component imports, their qualifying local use, collective expansions, and contextual concept namespaces across one loaded workspace.

    Produce deterministic relationship data and diagnostics without filesystem access, graph construction, or presentation.
  }

  interface {
    RelationshipResolution {
      resolveSigilRelationships(workspace) returns SigilResolution

      SigilResolution exposes the source workspace, resolved imports, resolved components, and accumulated diagnostics
    }

    ImportUse {
      each resolved imported name exposes whether and where it is used by qualifying component, public-concept, structural-expand, or module-index-surface evidence
    }

    CollectiveExpansions {
      each resolved component identifies its declaration source and every matching expand block
    }

    ConceptResolution {
      each resolved component exposes local, public, imported, and accessible concept identities with contextual occurrences and references
    }
  }
}

expand SigilResolver {
  logic {
    RelationshipResolution {
      Index component and expand declarations by name across loaded documents.

      Diagnose duplicate components and expands without matching components.

      Resolve explicit source imports and directory imports.

      Detect cycles between resolved import files.

      Diagnose each resolved imported name that has no qualifying local use.
    }

    ImportUse {
      Scan exact-case component names and imported public-concept identities in interface, state, logic, constraints, and cases.

      Record an applicable local expand as structural use of its imported component.

      Record a resolved direct import in ModuleIndexFile as intentional directory-surface use.

      Preserve source ownership, section, kind, and exact range for every use.
    }

    DirectoryImportSurface {
      Resolve directory imports through ModuleIndexFile.

      Build each directory-import surface from local components and successfully resolved direct import names.

      Preserve original declaration files through chained module-index resolution.

      Do not add unnamed dependencies or other subtree files implicitly.
    }

    CollectiveExpansions {
      Collect every matching expand for each resolved component without override or shadowing.
    }

    ConceptResolution {
      Build one flat concept namespace from each component and its matching expands.

      Collect repeated concept blocks as occurrences of one identity.

      Expose interface concepts publicly and retain other concepts privately.

      Add imported public concepts as bare accessible identities.

      Preserve provider identity while retaining importer lines only in importer context.

      Re-expose an imported identity when reused in interface.

      Scan semantic-unit prose against unambiguous accessible concepts and record each exact-case whole-word match in ResolvedConceptNamespace.references.

      Diagnose different accessible identities whose names compare equal without regard to case.
    }
  }

  constraints {
    RelationshipResolution {
      Resolution consumes SigilSemanticModel data and emits SigilDiagnostics.

      Resolution performs no filesystem access.

      Missing or ambiguous relationships retain partial deterministic data when practical.
    }

    ImportUse {
      Use is evaluated separately for each imported name in its declaring source document.

      Goal, decisions, literal bodies, comments, annotations, other source documents, case-mismatched text, and identifier substrings do not count as use.

      Unresolved or ambiguous imported names do not additionally produce SIGIL_UNUSED_IMPORT.
    }

    ComponentContract {
      Imported dependency projections expose public goals and interfaces without collected expansions.
    }

    ConceptResolution {
      Provider projections never collect consumer-contributed contextual occurrences.

      Resolution provides no dotted qualification, aliases, or shadowing.

      A whole-word match is bounded by characters outside [A-Za-z0-9_-].

      Ambiguous identifiers, case-mismatched text, substrings, and unmatched words do not produce references.

      Unmatched words produce no unresolved-concept diagnostic.

      Literal bodies produce no concept references.
    }

    DependencyDirection {
      Graph construction and presentation projections remain outside SigilResolver.
    }
  }

  cases {
    RelationshipResolution {
      A valid named import connects its source file to the original component declaration.

      Missing sources or components produce stable diagnostics and partial import results.

      Duplicate components, unmatched expands, and import cycles produce stable diagnostics.

      One used and one unused component in the same import produce only one SIGIL_UNUSED_IMPORT.
    }

    ImportUse {
      A component name referenced only in goal or decisions does not use its import.

      An exact component reference in constraints uses its import.

      An imported public concept referenced in logic uses its provider import.

      A provider name appearing only in a LiteralBlock does not use its import.

      A resolved direct ModuleIndexFile import uses its name through the directory surface.
    }

    DirectoryImportSurface {
      A name exposed by ModuleIndexFile resolves to its original declaration.

      An unnamed dependency remains unavailable through directory-import shorthand but remains explicitly importable.
    }

    CollectiveExpansions {
      Multiple matching expands are all retained.
    }

    ConceptResolution {
      Imported public concepts are available as bare identities.

      Contextual reuse preserves provider identity without adding importer content upstream.

      A whole-word local or imported identifier produces a contextual reference with its originating ConceptIdentity.

      A differently cased identifier or identifier embedded within a larger word produces no reference.

      Two reachable identities equal without regard to case produce an ambiguity diagnostic.

      Private provider concepts and operational sections remain unavailable to importers.
    }
  }
}
