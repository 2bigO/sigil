@spec/language.sigil import { SigilModuleIndex }
@packages/core/src/model.sigil import { SigilSemanticModel }
@packages/core/src/resolver.sigil import { SigilResolver }

component SigilGraphBuilder {
  goal {
    Convert resolved Sigil relationships into deterministic structural graph data.

    Keep graph construction independent from parsing, filesystem access,
    diagnostics policy, and presentation.
  }

  interface {
    GraphConstruction {
      buildSigilGraph(resolution) returns SigilGraph
    }

    GraphData {
      SigilGraph exposes component nodes, file dependency edges, imported-component
      edges, and component-expansion edges
    }
  }
}

expand SigilGraphBuilder {
  logic {
    GraphConstruction {
      Create one component node for each resolved component.

      Create file dependency edges to immediate imported sources or ModuleIndexFile.

      Create imported-component edges to original component declarations.

      Create component-expansion edges for every collected expand.

      Preserve deterministic workspace and declaration ordering.
    }
  }

  constraints {
    GraphConstruction {
      Graph construction consumes SigilResolver relationship data.

      Graph construction performs no filesystem access, source parsing, or
      relationship reinterpretation.

      Graph construction adds no diagnostics.
    }

    GraphData {
      SigilSemanticModel owns the graph data shapes built here.

      Graph edges represent resolved structural relationships and do not claim
      behavioral compliance.
    }
  }

  cases {
    GraphData {
      A resolved import produces a file dependency edge and an imported-component
      edge.

      A directory import points its file edge to ModuleIndexFile and its component
      edge to the original declaration.

      An unresolved imported name produces no imported-component edge.

      Two matching expands produce two component-expansion edges.
    }
  }
}
