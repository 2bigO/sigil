@spec/language.sigil import { SigilLanguage, SigilWorkspaceConfig }
@packages/core import { SigilCore }
@packages/cli/src/installer.sigil import { SkillInstaller }

component SigilCli {
  goal {
    Expose deterministic Sigil language and workspace operations to agents, CI, scripts, debugging, and review workflows through a non-interactive command line.

    Keep workspace commands thin over core contracts while isolating skill installation as a focused host-filesystem responsibility.
  }

  interface {
    CliInvocation {
      sigil --help

      sigil <command-path> --help

      A command path consists of a command followed by zero or more nested subcommands.

      Empty, unknown, incomplete, or invalid invocations report the specific usage problem together with help for the longest recognized command path.

      sigil --version
    }

    SkillCatalog {
      sigil skill list
    }

    SkillInstallation {
      sigil skill install [--project] [--agent codex|claude|opencode|pi|all]
    }

    WorkspaceInitialization {
      sigil init [path] [--name value] [--include glob ...] [--exclude glob ...]
    }

    WorkspaceInspection {
      sigil version [path]

      sigil parse file

      sigil check [path]

      sigil graph [path]

      sigil context [path] (--component name | --file file)

      sigil render [path]

      context reports a scoped glossary projection for the selected component or file and its related sources

      context automatically reports public contracts and durable decisions from direct dependencies
    }

    GlossaryInspection {
      sigil glossary [path]

      reports authoritative entries, resolved contexts, source occurrences, and glossary diagnostics
    }

    StructuredOutput {
      structured output supports --format json and --pretty

      commands that produce no required stdout support --quiet
    }

    WorkspaceMutationBoundary {
      workspace inspection commands do not modify .sigil source

      init may create the .sigil directory, a missing ConfigFile, and a missing seeded GlossaryFile but no .sigil source
    }
  }
}

expand SigilCli {
  logic {
    CliInvocation {
      Top-level --help lists supported commands and global options without workspace discovery.

      --help following any recognized command path reports usage, operands, options, and immediate subcommands scoped to that path before ordinary validation or execution.

      Usage failures select help for the longest recognized command path and report it together with the specific problem.

      --version prints the CLI artifact version from packages/cli/deno.json without workspace discovery.
    }

    SkillCatalog {
      skill list delegates bundled-skill discovery to SkillInstaller and reports valid skills with supported installation targets without changing the filesystem.
    }

    SkillInstallation {
      skill install delegates installation to SkillInstaller.

      skill install uses global scope and all supported agents by default.

      --project selects the current repository and --agent limits installation to one named agent.
    }

    WorkspaceInitialization {
      init writes ConfigFile with the supported language version and refuses to overwrite an existing file.

      init defaults workspace.name to the target-directory basename and workspace.members to an empty array.

      init applies the configured default SourceSelection and ToolConfiguration values.

      init creates a missing GlossaryFile containing only the decision-record field labels.

      The seeded entries are Decision:, Scope:, Assumptions:, Trade-offs:, Design issues addressed:, Discarded alternatives:, Consequences:, and Revisit when:.

      Every seeded entry sets agentContext to false and the glossary has no bounded contexts.

      init preserves an existing GlossaryFile instead of merging, replacing, or normalizing it.
    }

    WorkspaceInspection {
      version reports CLI and core artifact versions and the configured LanguageVersion when available.

      parse discovers and validates configuration before interpreting the selected source.

      check, graph, context, and render delegate workspace semantics to SigilCore.

      context obtains effective terminology for selected and related files from SigilCore.

      check reports core warnings, hints, and errors without reinterpreting them.

      Workspace source discovery skips symlink entries so installed skills cannot re-enter the workspace as duplicate Sigil sources.

      A configuration error prevents source loading and parse JSON reports document: null with diagnostics.
    }

    GlossaryInspection {
      glossary delegates loading, context resolution, occurrence matching, and diagnostics to SigilCore.
    }
  }

  constraints {
    ArtifactVersionOwnership {
      packages/cli/deno.json owns the CLI artifact version.

      The CLI Sigil contract does not duplicate its manifest-owned version literal.
    }

    StructuredOutput {
      Every workspace-dependent JSON result includes workspaceRoot, configPath, sigilVersion, and workspaceName.

      CLI operations are deterministic and non-interactive.

      context JSON output includes glossaryContext with the glossary path, resolved bounded contexts, canonical terms, definitions, aliases, and relevant occurrences.

      context JSON labels dependency decisions as agent rationale outside the dependent-facing contract.

      glossary JSON output includes workspace metadata, glossary path, schema version, contexts, terms, occurrences, and diagnostics.
    }

    WorkspaceMutationBoundary {
      parse, version, check, graph, context, and render do not modify .sigil source.

      init is the only workspace command that creates Sigil-owned content and creates only the .sigil directory, a missing ConfigFile, and a missing seeded GlossaryFile.

      Skill commands do not require or modify ConfigFile.

      glossary is a read-only workspace inspection command.
    }

    SkillInstallation {
      Skill installation never overwrites unmanaged files, directories, or links.
    }

    ExitStatus {
      Explicit help for any recognized command path exits with code 0.

      Empty, unknown, incomplete, or invalid usage exits with code 2, writes the problem and contextually relevant help to stderr, and leaves stdout empty.

      Exit code 0 means success or warnings only.

      Exit code 1 means configuration or Sigil error diagnostics.

      Exit code 2 means invalid command usage.

      Exit code 3 means a host or runtime failure.
    }
  }

  decisions {
    CliInvocation {
      Decision: Resolve explicit help and usage-error help against the longest recognized path in the command tree.

      Scope: Governs the top level and supported command paths at any nesting depth, including future subcommands.

      Trade-offs: Help routing must recognize partial command paths even when the remaining invocation is incomplete or invalid.

      Discarded alternatives: Describing individual subcommands and showing only the usage problem were rejected because both require repeated maintenance as the command tree grows.

      Consequences: New commands and nested subcommands inherit the same contextual-help behavior without requiring new semantic rules.

      Revisit when: Command metadata becomes the shared source for parsing, validation, and generated help.
    }

    StructuredOutput {
      Decision: Treat the CLI as a deterministic automation interface with JSON as its stable output contract and human text as a convenience.

      Scope: Governs CLI result shaping and workspace metadata; excludes LSP and editor presentation.

      Trade-offs: Rich interactive terminal workflows remain outside the CLI.

      Consequences: Workspace-dependent JSON exposes consistent metadata, diagnostics, and command-specific data.

      Revisit when: A reviewed interactive terminal workflow becomes a primary user requirement.
    }

    WorkspaceMutationBoundary {
      Decision: Keep workspace inspection commands read-only and restrict workspace initialization to creating missing configuration and seed-glossary files.

      Scope: Governs version, parse, check, glossary, graph, context, render, and init; excludes explicitly requested skill-installation side effects.

      Trade-offs: Initialization performs two explicit file creations, while inspection provides no automatic formatting or diagnostic repair.

      Discarded alternatives: Implicit source repair, inspection-time mutation, and overwriting an existing GlossaryFile were rejected.

      Consequences: Semantic Sigil mutation remains an explicitly approved host-workflow responsibility and user-owned glossary content is preserved.

      Revisit when: A separately approved mutation protocol defines preview, ownership, merging, and rollback behavior.
    }

    WorkspaceInitialization {
      Decision: Seed the eight colon-qualified decision-record field labels as workspace-neutral initialization vocabulary and exclude their definitions from agent context.

      Scope: Governs a newly created GlossaryFile; excludes project-domain vocabulary, the umbrella phrase decision record convention, Context, and existing glossary content.

      Trade-offs: Including punctuation makes recognition specific to field labels instead of matching ordinary uses of words such as decision, scope, and consequences.

      Design issues addressed: Authors need definitions for the individual decision-record fields rather than an umbrella definition for the convention.

      Discarded alternatives: A single decision record convention entry and unpunctuated field terms were rejected.

      Consequences: Editors and glossary inspection explain each field independently without duplicating those explanations in agent context.

      Revisit when: The decision-record convention adds, removes, or renames a field.
    }
  }

  cases {
    CliInvocation {
      Explicit help for a recognized command path reports that path's usage, operands, options, and immediate subcommands.

      An empty or unknown top-level command reports the problem with top-level help.

      An unknown subcommand reports the problem with help for its recognized parent command path.

      A missing operand, unsupported option, or extra operand reports the problem with help for the longest recognized command path.

      Explicit help succeeds without required operands or workspace discovery.
    }

    SkillCatalog {
      skill list includes valid bundled skills and excludes directories without SKILL.md.
    }

    SkillInstallation {
      Default installation targets Codex, Claude Code, OpenCode, and Pi.

      --project changes only skill destinations inside the current repository.
    }

    WorkspaceInitialization {
      init in an empty directory creates valid ConfigFile using the directory basename as workspace.name.

      init against existing ConfigFile reports an error and leaves it unchanged.

      init in an empty directory creates ConfigFile and GlossaryFile.

      The seeded GlossaryFile contains only Decision:, Scope:, Assumptions:, Trade-offs:, Design issues addressed:, Discarded alternatives:, Consequences:, and Revisit when:, each with agentContext false, plus an empty contexts array.

      init preserves an existing GlossaryFile unchanged.
    }

    WorkspaceInspection {
      version in a valid workspace reports CLI, core, and language versions from their owning sources.

      check from a nested directory resolves the nearest eligible ConfigFile.

      Missing interface concept identifiers appear in text and JSON output while check exits successfully when no errors exist.

      Invalid or ambiguous concept identities make check exit with code 1.

      render JSON includes workspace metadata and Markdown review content.

      context for a component with multiple expands reports every related expansion source.

      context for a component with glossary terms reports only terminology effective in or occurring within the component and its related expansion sources.

      context without GlossaryFile reports an absent glossary context without error.

      context for a component reports each direct dependency's public contract and decision sections once.

      context excludes transitive dependency decisions and non-decision private dependency sections.
    }

    GlossaryInspection {
      A workspace without GlossaryFile reports an absent glossary and no glossary error.

      Context overlap or spelling collision appears in text and JSON output and exits with code 1.
    }

    ExitStatus {
      An unreadable required file produces exit code 3 rather than an unresolved-import diagnostic.
    }
  }
}
