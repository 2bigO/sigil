@packages/compiler import { SigilCompilationSession, SigilCompilationSessionFactory }

component CompilationSessionCommand {
  goal {
    Adapt durable compiler proposal sessions into explicit non-interactive CLI
    commands without taking ownership of compiler session lifecycle policy.
  }

  interface {
    CompilationSessionCommands {
      sigil compile session start [path] --focus design [--component name | --file
      file] [--profile name]

      sigil compile session evaluate session-id [--format jsonl] reads one complete
      CompilationProposal JSON object from standard input

      sigil compile session refresh session-id rebuilds the frozen base snapshot

      sigil compile session close session-id releases the proposal workspace
    }
  }
}

expand CompilationSessionCommand {
  logic {
    CompilationSessionCommands {
      session start delegates creation and base materialization to
      SigilCompilationSessionFactory and returns the opaque session identifier, base
      fingerprint, and expiry.

      session evaluate resolves the existing SigilCompilationSession, reads exactly
      one proposal from standard input, and projects its ordinary CompilationEvent
      stream.

      Each accepted session refresh creates a new observable base epoch. Session
      close is idempotent only after the session identity and compiler ownership
      marker have been validated.
    }
  }

  constraints {
    CompilationSessionCommands {
      Session identifiers are opaque, unpredictable, and valid only for
      compiler-owned proposal workspaces.

      A session identifier locates a record but does not authorize access. The same
      operating-system user boundary, durable record, and ownership marker govern
      access and cleanup.

      Session start binds path, target, profile, focus, and expiry for later
      evaluations.

      Session start delegates validation, proposal-workspace creation, durable record
      creation, and failed-create cleanup to SigilCompilationSessionFactory without
      independently reclassifying dependency failures.

      Session evaluate accepts proposal JSON only from standard input and does not
      create a proposal file in the selected workspace.

      Session commands preserve compiler status and host-failure exit semantics.

      COMPILER_INVALID_INVOCATION is a caller usage failure and exits with code 2.

      COMPILER_PROFILE_EVALUATORS_REQUIRED and proposal-workspace, persistence,
      cleanup, event-protocol, or transport failure exit with code 3 and return no
      session identity or completed report.
    }
  }

  decisions {
    CompilationSessionCommands {
      Decision: Expose explicit start, evaluate, refresh, and close commands through
      a narrow CLI adapter over compiler-owned proposal sessions.

      Scope: Governs cross-process CLI transport for SigilCompilationSession;
      excludes session identity, leases, expiry, cleanup, and proposal-workspace
      lifecycle ownership in the compiler.

      Trade-offs: The CLI gains lifecycle commands and must validate command inputs,
      opaque session identifiers, and standard-input proposal JSON.

      Design issues addressed: Sigil skill conversations span multiple commands and
      user turns, so an in-process session alone cannot reliably preserve the
      reusable proposal workspace.

      Discarded alternatives: One-shot compilation and an indefinitely running CLI
      process were rejected because they respectively repeat workspace copying or
      depend on host-specific process retention.

      Consequences: Coding-agent hosts can iterate on unwritten proposals efficiently
      while session lifecycle ownership and cleanup remain explicit in the compiler.
    }
  }

  cases {
    CompilationSessionCommands {
      Starting a design session returns one opaque identifier and one frozen base
      fingerprint.

      Evaluating two successive proposals reuses the session workspace and reports
      distinct generations and proposal fingerprints.

      Refreshing a session clears its proposal-generation history.

      Closing or expiring a session prevents later evaluation through its identifier.
    }
  }
}
