; Loaded only in the Design EGraph. No Design fact populates Implementation.
(relation required-unit (String String))
(relation design-obligation (String String String String))
(function design-filled (String String String String) i64 :merge (max old new))
(relation design-unresolved (String String String String))
; origin, subject, predicate, object, expected, lowering law.
(relation coverage (String String String String String String))
(relation numeric-obligation (String String f64 String))

; Inventory supplies required interpretation independently of model assertions.
(rule ((required-unit c owner))
      ((kind c "Contract" c) (boolean c "required" "true" c)
       (edge owner "hasContract" c c)) :ruleset closure)
(rule ((contract-kind c) (boolean c "required" "true" f))
      ((design-obligation c c "interpretation" c)
       (set (design-filled c c "interpretation" c) 0)) :ruleset closure)
(rule ((proposition c s p o expected))
      ((set (design-filled c c "interpretation" c) 1)) :ruleset closure)
(rule ((boolean c "assumed" "true" f))
      ((design-obligation f c "assumption" c)
       (set (design-filled f c "assumption" c) 0)) :ruleset closure)

(rule ((edge a "requires" c f))
      ((design-obligation f a "provides" c)
       (set (design-filled f a "provides" c) 0)) :ruleset closure)
(rule ((proposition c s p o "true") (boolean c "required" "true" f))
      ((design-obligation c s p o)
       (set (design-filled c s p o) 0)) :ruleset closure)
(rule ((design-obligation id s p o) (known s p o))
      ((set (design-filled id s p o) 1)) :ruleset closure)
(rule ((design-obligation id a "provides" c) (known a "dependsOn" b) (known b "provides" c))
      ((set (design-filled id a "provides" c) 1)) :ruleset closure)
(rule ((kind c "State" k) (boolean c "required" "true" f))
      ((design-obligation f c "owner" c)
       (set (design-filled f c "owner" c) 0)) :ruleset closure)
(rule ((design-obligation id c "owner" c) (known a "owns" c))
      ((set (design-filled id c "owner" c) 1)) :ruleset closure)

; Fixed lowering table for requirements on independently reconstructed code.
; Metadata and other descriptive edges create no automatic code obligations.
(rule ((known s "provides" o))
      ((coverage s s "provides" o "true" "provides")) :ruleset closure)
(rule ((known s "requires" o))
      ((coverage s s "provides" o "true" "requires")) :ruleset closure)
(rule ((known s "excludes" o))
      ((coverage s s "uses" o "false" "excludes")) :ruleset closure)
(rule ((proposition c s p o expected) (boolean c "required" "true" f))
      ((coverage c s p o expected "required-proposition")) :ruleset closure)
(rule ((number s "latencyBudgetMs" budget f))
      ((numeric-obligation s "latencyMs" budget f)) :ruleset closure)

; Absence is inspected only after the complete closure, never while it grows.
(rule ((design-obligation id s p o) (= (design-filled id s p o) 0))
      ((design-unresolved id s p o)) :ruleset diagnostics)
