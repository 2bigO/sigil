; Fixed world enrichment, shared by separate Design and Implementation instances.
(relation kind (String String String))
(relation edge (String String String String))
(relation boolean (String String String String))
(relation text (String String String String))
(relation number (String String f64 String))
(relation known (String String String))
(relation reachable (String String))
; subject, predicate, object, rule, direct fact ID or intermediary identity.
(relation because (String String String String String))
(relation violation (String String String String))
(relation contract-kind (String))
(relation proposition (String String String String String))
(function distance (String String) f64 :merge (min old new))
(function peak-risk (String) f64 :merge (max old new))
(relation path-cost (String String f64))
(relation risk-score (String f64))
(relation arithmetic-limit (String String String))
(ruleset closure)
(ruleset diagnostics)

(rule ((edge s p o f)) ((known s p o) (because s p o "asserted" f)) :ruleset closure)
(rule ((known a "dependsOn" b))
      ((reachable a b) (because a "reachable" b "dependency-direct" b)) :ruleset closure)
(rule ((reachable a b) (known b "dependsOn" c))
      ((reachable a c) (because a "reachable" c "dependency-transitive" b)) :ruleset closure)
(rule ((known a "delegates" b) (known b "provides" c))
      ((known a "provides" c) (because a "provides" c "delegated-capability" b)) :ruleset closure)

(rule ((edge a "excludes" c f) (known a "provides" c))
      ((violation "excluded-capability" a c f)) :ruleset closure)
(rule ((edge a "excludes" c f) (known a "uses" c))
      ((violation "excluded-use" a c f)) :ruleset closure)
(rule ((boolean c "exclusive" "true" f) (known a "owns" c) (known b "owns" c) (!= a b))
      ((violation "exclusive-ownership" a b f)) :ruleset closure)
(rule ((boolean a p x f) (boolean a p y g) (!= x y))
      ((violation "conflicting-boolean" a p f)) :ruleset closure)
(rule ((number s p a f) (number s p b g) (!= a b))
      ((violation "conflicting-number" s p f)) :ruleset closure)
(rule ((number a "latencyBudgetMs" budget f) (number a "latencyMs" actual g) (> actual budget))
      ((violation "latency-budget" a a f)) :ruleset closure)

(rule ((kind c "Contract" f)) ((contract-kind c)) :ruleset closure)
(rule ((kind c "Proposition" f)) ((contract-kind c)) :ruleset closure)
(rule ((kind c "Goal" f)) ((contract-kind c)) :ruleset closure)
(rule ((kind c "Interface" f)) ((contract-kind c)) :ruleset closure)
(rule ((kind c "Logic" f)) ((contract-kind c)) :ruleset closure)
(rule ((kind c "Constraint" f)) ((contract-kind c)) :ruleset closure)
(rule ((kind c "Decision" f)) ((contract-kind c)) :ruleset closure)
(rule ((kind c "Case" f)) ((contract-kind c)) :ruleset closure)
(rule ((contract-kind c) (known c "from" s) (text c "relation" p g)
       (known c "target" o) (boolean c "expected" expected i))
      ((proposition c s p o expected)) :ruleset closure)
(rule ((proposition c s p o "false") (known s p o) (boolean c "expected" "false" f))
      ((violation "negative-contract" c s f)) :ruleset closure)
(rule ((proposition c s p o "true") (boolean c "required" "true" f)
       (proposition d s p o "false") (boolean d "required" "true" g))
      ((violation "contradictory-contracts" c d f)) :ruleset closure)
(relation contract-endpoint (String))
(contract-endpoint "from")
(contract-endpoint "target")
(rule ((contract-kind c) (contract-endpoint p) (edge c p a f) (edge c p b g) (!= a b))
      ((violation "conflicting-contract-shape" c p f)) :ruleset closure)
(rule ((contract-kind c) (text c "relation" a f) (text c "relation" b g) (!= a b))
      ((violation "conflicting-contract-shape" c "relation" f)) :ruleset closure)
(relation dependency-endpoint (String))
(dependency-endpoint "from")
(dependency-endpoint "to")
(rule ((kind d "Dependency" k) (dependency-endpoint p) (edge d p a f) (edge d p b g) (!= a b))
      ((violation "conflicting-dependency-shape" d p f)) :ruleset closure)

(rule ((kind d "Dependency" k) (known d "from" a) (known d "to" b) (number d "cost" cost h))
      ((set (distance a b) cost) (because a "distance" b "dependency-cost" h)) :ruleset closure)
(rule ((= (distance a b) x) (= (distance b c) y) (<= (+ x y) 9007199254740991.0))
      ((set (distance a c) (+ x y)) (because a "distance" c "path-cost" b)) :ruleset closure)
(rule ((= (distance a b) x) (= (distance b c) y) (> (+ x y) 9007199254740991.0))
      ((arithmetic-limit a b c)) :ruleset closure)
(rule ((number a "risk" r f)) ((set (peak-risk a) r)) :ruleset closure)
(rule ((reachable a b) (= (peak-risk b) r)) ((set (peak-risk a) r)) :ruleset closure)

; Export final numerical views only after closure has stabilized.
(rule ((= (distance a b) cost)) ((path-cost a b cost)) :ruleset diagnostics)
(rule ((= (peak-risk a) risk)) ((risk-score a risk)) :ruleset diagnostics)
