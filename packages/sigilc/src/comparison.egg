; Only finite Design obligations and independently saturated Implementation
; results enter this instance. There is no Design known/edge input.
(relation obligation (String String String String String String))
(relation actual (String String String))
(relation actual-number (String String f64 String))
(relation budget (String String String f64))
(function answered (String) i64 :merge (max old new))
(relation satisfied (String))
(relation disagreement (String String String))
(relation unresolved (String))
(ruleset closure)
(ruleset diagnostics)

(rule ((obligation id s p o expected law)) ((set (answered id) 0)) :ruleset closure)
(rule ((obligation id s p o "true" law) (actual s p o))
      ((set (answered id) 1) (satisfied id)) :ruleset closure)
(rule ((obligation id s "provides" o "true" "requires")
       (actual s "dependsOn" b) (actual b "provides" o))
      ((set (answered id) 1) (satisfied id)) :ruleset closure)
(rule ((obligation id s p o "false" law) (actual s p o))
      ((set (answered id) 1) (disagreement id "prohibited-relation" s)) :ruleset closure)
(rule ((obligation id s "owner" s "true" "required-state-owner") (actual a "owns" s))
      ((set (answered id) 1) (satisfied id)) :ruleset closure)
(rule ((obligation id s "multiple-owners" s "false" "exclusive-ownership")
       (actual a "owns" s) (actual b "owns" s) (!= a b))
      ((set (answered id) 1) (disagreement id "exclusive-ownership" s)) :ruleset closure)
; No rule satisfies a negative obligation from a missing positive row.
(rule ((budget id s p bound)) ((set (answered id) 0)) :ruleset closure)
(rule ((budget id s p bound) (actual-number s p n f) (<= n bound))
      ((set (answered id) 1) (satisfied id)) :ruleset closure)
(rule ((budget id s p bound) (actual-number s p n f) (> n bound))
      ((set (answered id) 1) (disagreement id "numeric-budget" f)) :ruleset closure)
(rule ((= (answered id) 0)) ((unresolved id)) :ruleset diagnostics)
