@packages/compiler-adapter-claude/src/claude-adapter.sigil import { SigilClaudeCompilerAdapter }

component SigilClaudeCompilerAdapterPackage {
  goal {
    Package the Claude Code compiler adapter independently and supply it to the
    Sigil CLI bundle without entering the provider-neutral compiler package.
  }

  interface {
    ClaudeAdapterPackage {
      SigilClaudeCompilerAdapter is the public adapter contract.
    }
  }
}

expand SigilClaudeCompilerAdapterPackage {
  constraints {
    PackageBoundary {
      The package depends on compiler contracts. The compiler does not depend on this
      package; the CLI owns registration and release assembly.
    }
  }
}
