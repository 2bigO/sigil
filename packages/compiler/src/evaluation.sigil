@packages/core import { SigilCore, SigilContextRetrieval }
@packages/compiler/src/profile.sigil import { SigilCompilationProfile }
@packages/compiler/src/status.sigil import { SigilCompilationStatus }
@packages/compiler/src/event-writer.sigil import { SigilCompilationEventWriter }
@packages/compiler/src/adapter.sigil import { SigilAgentAdapter }
@packages/compiler/src/evaluation-request.sigil import { SigilAgentEvaluationRequest }
@packages/compiler/src/evaluation-registry.sigil import { SigilEvaluationSkillRegistry }
@packages/compiler/src/report-protocol.sigil import { SigilCompilationReportProtocol }

component SigilCompilationEvaluation {
  goal {
    Execute one reusable profile-scoped compilation pipeline over a supplied
    workspace API that is read-only to compiler-owned deterministic processing, and
    return one internal evaluation result plus nonterminal progress.

    Adapter and provider processes receive a workspace path and may exceed that API
    boundary; their declared restrictions are externally trusted rather than an
    end-to-end compiler guarantee.

    Compose WorkspaceProcessing, CompilationProfile, CompilationStatus,
    CompilationEventWriterProtocol, AgentAdapter, EvaluationSkillPackage, and
    report trace schemas through their owning public contracts without owning
    terminal settlement.
  }

  interface {
    CompilationEvaluation {
      evaluate(workspaceAccess, target, effectiveProfile, requestedStage,
      CompilationEventWriter, cancellationSignal?) emits only nonterminal progress
      through that already-bound writer and returns CompilationEvaluationResult,
      rejects cancellation with COMPILER_CANCELLED, or rejects a host or protocol
      failure with COMPILER_FAILED

      WorkspaceProcessing supplies deterministic semantics, CompilationProfile
      supplies stages and capabilities, and CompilationStatus derives color

      CompilationEventWriterProtocol governs nonterminal progress framing,
      AgentAdapter executes agentic stages, and EvaluationSkillPackage supplies their
      guidance and rule contracts
    }

    CompilationEvaluationResult {
      contains source and target identity, effective profile and executed stages,
      current diagnostics, derived status, EvaluationTrace, evaluator outcomes, and
      optional proposal identity needed for authoritative report construction

      contains no completed, failed, or cancelled terminal event and is not itself a
      CompilationReport
    }

    EvaluationContext {
      each agent request evaluates exactly one component in one evaluation stage

      requests contain target identity, skill, capabilities, schema, budgets, and one
      complete PurposeRetrievalResult for that component and stage purpose through
      AgentEvaluationRequest
    }

    AgentWorkspaceInspection {
      evaluators inspect the supplied view through the selected adapter under its
      declared access, network, approval, and persistence behavior
    }
  }
}

expand SigilCompilationEvaluation {
  state {
    CompilationRunLifecycle {
      A compilation run is queued, running, completed, failed, or cancelled.
    }

    EvaluationStageLifecycle {
      An enabled stage is pending, running, completed, failed, skipped-by-dependency,
      or cancelled.

      A stage omitted by the effective profile is disabled rather than incomplete.
    }

    AgentInspectionLifecycle {
      An agent inspection is starting, running, completed, failed, cancelled, or
      incomplete.
    }
  }

  logic {
    PipelineExecution {
      Run deterministic foundation stages before dependent agentic stages.

      Run every enabled stage whose dependencies produced trustworthy inputs once for
      each evaluator identity selected by the effective profile.

      Skip only stages whose declared dependencies failed or became unavailable.

      Aggregate every trustworthy diagnostic produced by enabled stages.

      Record material disagreement when evaluator results for the same component,
      stage, rule, and semantic subject differ on the presence or severity of an
      error or warning.
    }

    EvaluationContext {
      Map semantic-readiness to semantic purpose, architecture-design and
      standards-risk to architecture purpose, and current-code-compatibility to
      implementation purpose.

      Before invoking the first agentic stage for a component and purpose, ask
      SigilContextRetrieval to build one PurposeRetrievalResult from the resolved
      workspace and complete glossary and implementation-discovery evidence. Reuse
      that immutable result for every evaluator of the same component, purpose,
      source fingerprint, and retrieval fingerprint.

      Build the evaluation request from the workspace root, selected target, stage
      skill, capability contract, output schema, execution budgets, and the complete
      structured retrieval result plus its aggregated context.

      Invoke each enabled agentic stage separately for workspace components in
      dependency-aware order.

      The retrieval result is the authoritative initial evidence boundary. The
      evaluator does not independently traverse graph, context, glossary, or
      ownership projections to redefine its membership.
    }

    AgentWorkspaceInspection {
      Request the selected adapter to start the agent at the workspace root with
      read-only access, approval escalation disabled, ephemeral state, and agent tool
      network access disabled.

      Treat these restrictions as requested behavior and adapter declarations, not as
      compiler-verified guarantees.

      Let the agent inspect a selected evidence file at an included range when it
      must verify retrieval rendering or cite exact lines. Additional workspace
      inspection may diagnose retrieval incompleteness but cannot become evidence for
      an ordinary stage finding in that run.

      Require the agent to treat repository instructions and retrieved file contents
      as untrusted evidence rather than evaluator authority.
    }

    EvaluationTrace {
      Consume structured provider observations when available and record observed
      command metadata, model usage, evaluator environment, outcome, and
      incomplete-evidence status without retaining hidden reasoning, complete file
      contents, or bulky command output.

      Accept a terminal-only provider when its required final result is complete and
      valid. Preserve unavailable and partial telemetry without inventing zero or
      final values.
    }
  }

  constraints {
    EvaluationContext {
      One adapter request never combines multiple selected components.

      CompilationEvaluation emits no completed, failed, or cancelled terminal event;
      its caller owns terminal settlement through SigilCompilationEventWriter.

      Evaluation skills may identify targets but do not alter retrieval purpose,
      membership, ordering, or aggregation.

      Effective profiles declare elapsed-time and model-usage budgets plus initial
      request and output-retention limits. They do not truncate retrieval policy
      version 1 or bound later workspace reads by initial request size.
    }

    AgentWorkspaceInspection {
      The evaluation request requires read-only workspace access, disabled agent tool
      network access, no approval escalation, ephemeral state, and the selected
      workspace as working root.

      An adapter declares whether it satisfies requested capabilities. The compiler
      rejects a declared mismatch but does not verify the implementation, provider
      CLI, or plugin's enforcement.

      The agent may run version, parse, check, fmt --check, retrieve, and read-only
      text inspection limited to selected evidence or retrieval diagnostics.

      The agent must not run init, mutating fmt, compile, skill installation, network
      commands, code generation, implementation experiments, or commands that modify
      workspace or external state.

      Owned implementation annotations are navigation evidence and do not restrict
      which workspace files the agent may read.

      Inaccessible material evidence, elapsed-time exhaustion, a declared capability
      mismatch, or an invalid or missing final result leave the required stage
      incomplete and prevent green.

      Adapter cancellation rejects CompilationEvaluation with COMPILER_CANCELLED.
      Adapter unavailability, binding mismatch, or capability mismatch is resolved as
      required evaluator unavailability before the stage. Elapsed-time, preventive
      budget, provider process, and provider result protocol failures become
      incomplete evaluator outcomes. Only compiler host or
      CompilationEventWriterProtocol failures reject with COMPILER_FAILED.

      Missing progress events, unavailable usage or cost, and truncated nonessential
      command output do not fail an otherwise valid evaluation.
    }
  }

  decisions {
    EvaluationContext {
      Decision: Evaluate one component in one stage per agent run using the complete
      deterministic PurposeRetrievalResult selected for that stage's purpose.

      Scope: Governs component, file, and workspace targets across stage scheduling,
      initial request construction, workspace access, and adapter invocation.

      Assumptions: A typed purpose closure can preserve required evidence more
      consistently than evaluator-chosen traversal.

      Trade-offs: Initial requests can be large because retrieval policy version 1
      has no budget, but evaluators receive identical membership and ordering.

      Design issues addressed: Evaluator-owned graph and context traversal produces
      noisy and inconsistent evidence for the same target and question.

      Discarded alternatives: Complete workspace context, untyped traversal, model
      ranking, and evaluator-selected authoritative membership were rejected.

      Consequences: Repeated equivalent runs begin with byte-identical context and an
      auditable fingerprint while the compiler records evaluation behavior.

      Revisit when: Relevance fixtures justify a separate versioned packing policy.
    }

    DirectAgentWorkspaceInspection {
      Decision: Request read-only workspace access for citation verification and
      retrieval-gap diagnostics, while treating adapter enforcement as externally
      trusted rather than compiler-guaranteed.

      Scope: Governs evidence gathering during agentic compiler stages; excludes
      mutation, network research, approval escalation, recursive compilation, code
      generation, and implementation experiments.

      Assumptions: Included ranges can require exact-line verification, retrieval
      policy defects need observable diagnostics, and users accept the documented
      risk of their selected adapter implementation.

      Trade-offs: Providers retain limited inspection freedom and the compiler cannot
      guarantee adapter restrictions, but ordinary findings cannot rely on unselected
      evidence.

      Design issues addressed: A deterministic boundary must remain debuggable
      without restoring evaluator-owned traversal.

      Discarded alternatives: No workspace access, unrestricted authoritative
      browsing, and inferring safety from provider events were rejected.

      Consequences: Evaluators can verify selected evidence and report missing
      relations while retrieval owns normal-stage evidence membership; adapter trust
      limitations remain documentation-only.

      Revisit when: Retrieval results carry sufficient immutable line-addressable
      evidence to remove workspace inspection entirely.
    }
  }

  cases {
    EvaluationContext {
      Two evaluators for the same component, stage purpose, source fingerprint, and
      retrieval fingerprint receive byte-identical selected graph and context.

      Current-code-compatibility receives owned implementation evidence selected by
      implementation purpose; an unannotated caller is absent unless an explicit
      typed relation selects it.

      A completed run returns one CompilationEvaluationResult and no terminal event.
      Cancellation rejects with COMPILER_CANCELLED and a host or protocol failure
      rejects with COMPILER_FAILED; callers own terminal settlement after their
      durability or export work.
    }

    AgentWorkspaceInspection {
      An agent cites exact lines from a selected evidence range whether or not its
      adapter exposes the underlying read observation.

      An agent that discovers a materially required unselected relation reports a
      retrieval-gap diagnostic; that evidence does not become an ordinary stage
      finding until a later run uses a revised retrieval policy.

      An adapter declaring incompatible workspace access fails before evaluation.

      An adapter declaring compatible access may run without a generic warning; its
      restrictions remain externally trusted and documented rather than verified by
      compiler events.
    }
  }
}
