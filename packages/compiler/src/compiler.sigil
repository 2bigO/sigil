@packages/core import { SigilCore }
@packages/compiler/src/compilation-target.sigil import { SigilCompilationTarget }
@packages/compiler/src/semantic/_module.sigil import { SigilSemanticKernel, SigilSemanticState, SigilSemanticProfile }
@packages/compiler/src/event-writer.sigil import { SigilCompilationEventWriter }
@packages/compiler/src/report-protocol.sigil import { SigilCompilationReportProtocol }
@packages/compiler/src/history-store.sigil import { SigilCompilationHistoryStore }
@packages/compiler/src/report-export.sigil import { SigilCompilationReportExporter }

component SigilOneShotCompilation {
  goal {
    Compile the selected current Sigil contracts and asserted semantic state with
    deterministic structural validation and Sigil's fixed egglog laws. Coordinate
    target resolution, event settlement, report construction, export, and history.
  }

  interface {
    OneShotCompilation {
      compile(workspacePath, target, profileName, options?) returns the authoritative
      CompilationReport after completed-event delivery.

      Invalid target, workspace path, profile, stage, or conflicting focus options
      reject before event binding. Operational failure returns no semantic report.
      Every post-binding rejection emits its terminal event when transport permits.
      Required terminal delivery failure rejects with COMPILER_FAILED.
    }

    CompilationOptions {
      requestedStage selects an exact stage and its dependency closure. focus design
      selects semantic-closure; focus implementation selects implementation-coverage.
      The options are mutually exclusive. Omitting both runs the complete profile.

      semanticDocuments supplies ordinary Turtle assertions that augment current
      source contracts. semanticEngine selects the native executable, operational
      timeout, and host-owned implementation observations.

      disableHistory disables history reads and writes. cancellationSignal cancels
      before success linearization. reportExport requests atomic report export.
      eventSink and hostWarningSink are optional caller-owned delivery capabilities.
    }
  }
}

expand SigilOneShotCompilation {
  logic {
    OneShotCompilation {
      Delegate workspace loading and resolution to SigilCore, target selection to
      SigilCompilationTarget, and stage resolution to SigilSemanticProfile.
      Each source prose unit becomes a required semantic contract with its physical
      source location kept in a sidecar. Prose is unresolved until interpreted.

      Read canonical assertions through SigilSemanticState. Reuse them only when the
      receipt matches the current source intent fingerprint. Otherwise report stale
      interpretation and retain current source requirements. Union valid explicit
      assertions with protected source contracts, then select the dependency scope.

      Execute structural validation before semantic closure. Hard errors skip
      dependent stages. SigilSemanticKernel derives deterministic diagnostics and
      premise witnesses. Implementation coverage requires a green design and
      mechanically established observations. No model evaluator is invoked.

      Preserve source subjects, diagnostic lifecycle, profile, target, and snapshot
      identity in SigilCompilationReportProtocol. History is optional prior evidence
      and cannot establish current semantic truth.
    }

    CompilationInvocation {
      Observe cancellation until immediately before export begins, or immediately
      before completed-event delivery when export is absent. After this success
      linearization point, cancellation cannot change settlement. Export failure
      rejects and emits failed. Export success proceeds to completed delivery.

      Delegate event delivery to SigilCompilationEventWriter, history access to
      SigilCompilationHistoryStore, and requested export to
      SigilCompilationReportExporter. Replace history only after completed delivery. History read, write, and
      host-warning delivery failures are non-authoritative. Terminal delivery
      failure returns no report and performs no history replacement.
    }
  }

  constraints {
    ReadOnlyCompilation {
      Compilation reads selected source and canonical semantic state. Only event,
      report, history, explicit export and incremental artifact state may be written.
      Completed stages survive later failure in ignored target .sigil bundles;
      reports expose their identities. Artifact reads never grant evidence authority.
      Intent generation and canonical-state acceptance have separate APIs.
    }

    SemanticAuthority {
      An LLM may propose Turtle assertions but cannot supply compiler findings,
      laws, quality scores, or trusted implementation observations. Native failure
      cannot produce a green report. Persisted state contains assertions, not proof.
    }
  }

  cases {
    CompilationInvocation {
      Cancellation before success linearization prevents export and history
      replacement. History failure after completed delivery leaves the report intact.
    }

    OneShotCompilation {
      Uninterpreted prose is yellow. Violated invariants are red. A design with no
      unresolved required obligations is green. The same design in implementation
      focus is yellow until its derived coverage obligations are established.

      Source edits invalidate saved interpretation. Formatting-only prose wrapping
      retains semantic contract identities. Legacy evaluator configuration is not
      required for standard or critical-system compilation.
    }
  }
}
