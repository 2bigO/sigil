@packages/core import { SigilCore, SigilContextRetrieval }
@packages/compiler/src/adapter.sigil import { SigilAgentAdapter }
@packages/compiler/src/adapter-execution-coordinator.sigil import { SigilAgentAdapterExecutionCoordinator }
@packages/compiler/src/adapter-subprocess.sigil import { SigilAgentAdapterSubprocess }
@packages/compiler/src/evaluation-request.sigil import { SigilAgentEvaluationRequest }
@packages/compiler/src/compiler.sigil import { SigilOneShotCompilation }
@packages/compiler/src/report-markdown.sigil import { SigilCompilationReportMarkdown }
@packages/compiler/src/session-factory.sigil import { SigilCompilationSessionFactory }
@packages/compiler/src/session.sigil import { SigilCompilationSession }

component SigilCompiler {
  goal {
    Give designers and architects a compiler-like improvement loop for high-level
    Sigil contracts through profile-scoped deterministic and agentic evaluation.

    Keep profile/stage selection, target scheduling, adapter binding,
    event/report/history protocols, and read-only evaluation coordination inside
    the compiler. SigilCore owns configuration discovery, source selection/loading,
    parsing, resolution, graph/context retrieval, and deterministic language
    diagnostics.

    Proposal coordination may write only compiler-owned proposal and session state.
    The compiler does not replace human design approval.
  }

  interface {
    Compiler {
      OneShotCompilation is provided by SigilOneShotCompilation and returns one
      authoritative CompilationReport; lifecycle and event settlement remain owned by
      SigilOneShotCompilation

      SigilContextRetrieval supplies deterministic purpose evidence to evaluation;
      SigilCore remains the authority for deterministic workspace semantics

      SigilAgentAdapter defines the provider-neutral evaluation contract for adapters
      that return untrusted compilation candidates.

      SigilAgentAdapterExecutionCoordinator owns bounded adapter execution,
      cancellation, settlement, and cleanup coordination.

      SigilAgentAdapterSubprocess owns the provider-process lifecycle and exposes
      only the constrained subprocess capability required by adapters.

      SigilAgentEvaluationRequest defines the validated evaluation input supplied to
      an agent adapter.

      SigilOneShotCompilation owns one compilation invocation from validation and
      workspace acquisition through evaluation, reporting, export, and settlement.

      SigilCompilationReportMarkdown provides the shared deterministic Markdown
      projection of a completed authoritative CompilationReport.

      SigilCompilationSessionFactory creates durable compiler sessions; subsequent
      session operation and proposal-workspace lifecycle remain owned by
      SigilCompilationSession.
    }
  }
}

expand SigilCompiler {
  constraints {
    HumanAuthorityBoundary {
      Green status is evidence that every required stage of one exact source snapshot
      and profile completed without current errors, warnings, or material
      disagreement.

      Green status does not approve the design, authorize implementation, or replace
      an accountable human review.
    }
  }

  decisions {
    CompilerDeterministicBoundary {
      Decision: Keep compilation orchestration deterministic processing in
      SigilCompiler while delegating deterministic language and workspace semantics
      to SigilCore.

      Scope: Governs compiler/Core ownership; excludes agentic evaluation outcomes.

      Consequences: Compiler hosts share one orchestration protocol without
      duplicating parsing, resolution, retrieval, or language-diagnostic semantics.
    }

    CompilerBoundary {
      Decision: Place agent orchestration in a separate @qoherent/sigil-compiler
      package and expose it through thin host façades.

      Scope: Governs agentic Sigil compilation; excludes deterministic language
      interpretation owned by SigilCore.

      Trade-offs: Distribution gains another package and compatibility boundary.

      Design issues addressed: Agentic evaluation must not weaken the deterministic
      core contract.

      Discarded alternatives: Making SigilCore or SigilCli directly own semantic
      evaluation was rejected.

      Consequences: CLI, editors, and future hosts share one compiler protocol
      without duplicating orchestration.
    }

    CohesiveCompilerNamespace {
      Decision: Keep the compiler module index as a concise boundary summary and
      namespace assembly over imported cohesive components.

      Scope: Governs the compiler package module index.

      Trade-offs: Operational behavior is discovered through narrower component
      contracts rather than one large index.

      Design issues addressed: Target selection, terminal settlement, history,
      export, evaluation, and session policy change independently.

      Consequences: The index changes only when the package boundary or assembled
      public namespace changes.
    }

  }
}
