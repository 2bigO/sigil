; Sigil owns this vocabulary and these laws. Input is exclusively typed facts.
; The final column is an asserted fact identity, never a confidence score.
(relation kind (String String String String))
(relation edge (String String String String))
(relation boolean (String String String String))
(relation number (String String f64 String))
(relation text (String String String String))

(relation known (String String String String))
(relation reachable (String String String))
(relation obligation (String String String String))
(relation satisfied (String String))
(relation violation (String String String String))
(relation unresolved (String String String String))
(relation because (String String String String))
(function fulfilled (String) i64 :merge (max old new))
(function distance (String String) f64 :merge (min old new))
(function peak-risk (String) f64 :merge (max old new))
(relation path-cost (String String f64))
(relation risk-score (String f64))
(relation contract-kind (String))
(relation proposition (String String String String String))
(relation coverage (String String String String String))
(relation implementation-mode ())
; These tables come only from deterministic tool observations, never RDF input.
(relation observation (String String String String))
(relation complete-scope (String String String String))
(relation required-check (String))
(relation check-result (String String String))
(relation implementation-satisfied (String String))
(function implementation-fulfilled (String) i64 :merge (max old new))
(function observed-match (String) i64 :merge (max old new))
(ruleset closure)
(ruleset evidence-closure)
(ruleset diagnostics)

(rule ((edge s p o f)) ((known s p o f)) :ruleset closure)
(rule ((known a "dependsOn" b f))
      ((reachable a b (+ "reach|" a "|" b))
       (because (+ "reach|" a "|" b) "dependency-direct" f "")) :ruleset closure)
(rule ((reachable a b f) (known b "dependsOn" c g))
      ((reachable a c (+ "reach|" a "|" c))
       (because (+ "reach|" a "|" c) "dependency-transitive" f g)) :ruleset closure)
(rule ((known a "delegates" b f) (known b "provides" c g))
      ((known a "provides" c (+ "provides|" a "|" c))
       (because (+ "provides|" a "|" c) "delegated-capability" f g)) :ruleset closure)

(rule ((known a "requires" c f))
      ((obligation (+ "requires|" a "|" c) a "provides" c)
       (set (fulfilled (+ "requires|" a "|" c)) 0)
       (because (+ "requires|" a "|" c) "required-capability" f "")) :ruleset closure)
(rule ((obligation id a "provides" c) (known a "provides" c f))
      ((set (fulfilled id) 1) (satisfied id f)) :ruleset closure)
(rule ((obligation id a "provides" c) (known a "dependsOn" b f) (known b "provides" c g))
      ((set (fulfilled id) 1) (satisfied id (+ "available|" a "|" c))
       (because (+ "available|" a "|" c) "dependency-capability" f g)) :ruleset closure)

(rule ((known a "excludes" c f) (known a "provides" c g))
      ((violation "excluded-capability" a c f)
       (because (+ "violation|excluded-capability|" a "|" c) "exclusion" f g)) :ruleset closure)
(rule ((known a "excludes" c f) (known a "uses" c g))
      ((violation "excluded-use" a c f)
       (because (+ "violation|excluded-use|" a "|" c) "exclusion" f g)) :ruleset closure)
(rule ((boolean c "exclusive" "true" f) (known a "owns" c g) (known b "owns" c h) (!= a b))
      ((violation "exclusive-ownership" a b f)
       (because (+ "violation|exclusive-ownership|" a "|" b) "exclusive-ownership" g h)) :ruleset closure)
(rule ((boolean c "required" "true" f) (kind c "State" _ g))
      ((obligation (+ "owner|" c) c "owner" c)
       (set (fulfilled (+ "owner|" c)) 0)
       (because (+ "owner|" c) "required-state-owner" f g)) :ruleset closure)
(rule ((obligation id c "owner" c) (known a "owns" c f))
      ((set (fulfilled id) 1) (satisfied id f)) :ruleset closure)

; Prose-bearing contract kinds are the seven existing Sigil sections. A required
; unit remains unresolved until it has an executable proposition. An LLM's
; statement that it is interpreted is not proof and is not a vocabulary field.
(rule ((kind c "Contract" _ f)) ((contract-kind c)) :ruleset closure)
(rule ((kind c "Proposition" _ f)) ((contract-kind c)) :ruleset closure)
(rule ((kind c "Goal" _ f)) ((contract-kind c)) :ruleset closure)
(rule ((kind c "Interface" _ f)) ((contract-kind c)) :ruleset closure)
(rule ((kind c "Logic" _ f)) ((contract-kind c)) :ruleset closure)
(rule ((kind c "Constraint" _ f)) ((contract-kind c)) :ruleset closure)
(rule ((kind c "Decision" _ f)) ((contract-kind c)) :ruleset closure)
(rule ((kind c "Case" _ f)) ((contract-kind c)) :ruleset closure)
(rule ((contract-kind c) (boolean c "required" "true" f))
      ((obligation (+ "interpret|" c) c "interpretation" c)
       (set (fulfilled (+ "interpret|" c)) 0)
       (because (+ "interpret|" c) "required-contract-interpretation" f "")) :ruleset closure)
(rule ((contract-kind c) (edge c "from" s f) (text c "relation" p g)
       (edge c "target" o h) (boolean c "expected" expected i))
      ((proposition c s p o expected)
       (because (+ "proposition|" c) "contract-proposition" f g)
       (because (+ "proposition|" c) "contract-proposition" h i)) :ruleset closure)
(rule ((proposition c s p o expected) (obligation (+ "interpret|" c) c "interpretation" c))
      ((set (fulfilled (+ "interpret|" c)) 1)
       (satisfied (+ "interpret|" c) (+ "proposition|" c))) :ruleset closure)
(rule ((proposition c s p o "true") (boolean c "required" "true" f))
      ((obligation (+ "contract|" c) s p o)
       (set (fulfilled (+ "contract|" c)) 0)
       (coverage (+ "contract|" c) s p o "true")
       (because (+ "contract|" c) "required-positive-contract" (+ "proposition|" c) f)) :ruleset closure)
(rule ((proposition c s p o "true") (known s p o f))
      ((set (fulfilled (+ "contract|" c)) 1) (satisfied (+ "contract|" c) f)) :ruleset closure)
; A negative specification establishes a prohibition. It does not establish a
; negative observation of code; that needs complete mechanical evidence below.
(rule ((proposition c s p o "false") (boolean c "required" "true" f))
      ((obligation (+ "contract|" c) s (+ "not:" p) o)
       (set (fulfilled (+ "contract|" c)) 1)
       (satisfied (+ "contract|" c) (+ "proposition|" c))
       (coverage (+ "contract|" c) s p o "false")
       (because (+ "contract|" c) "required-negative-contract" (+ "proposition|" c) f)) :ruleset closure)
(rule ((proposition c s p o "false") (known s p o f))
      ((violation "negative-contract" c s f)
       (because (+ "violation|negative-contract|" c "|" s) "negative-contract" (+ "proposition|" c) f)) :ruleset closure)
(rule ((proposition c s p o "true") (boolean c "required" "true" f)
       (proposition d s p o "false") (boolean d "required" "true" g))
      ((violation "contradictory-contracts" c d f)
       (because (+ "violation|contradictory-contracts|" c "|" d) "opposed-required-propositions" (+ "proposition|" c) (+ "proposition|" d))) :ruleset closure)

; A green specification derives implementation work even before tools run.
(rule ((known s "provides" o f))
      ((coverage (+ "provide|" s "|" o) s "provides" o "true")
       (because (+ "provide|" s "|" o) "capability-implementation" f "")) :ruleset closure)
(rule ((known s "excludes" o f))
      ((coverage (+ "exclude|" s "|" o) s "uses" o "false")
       (because (+ "exclude|" s "|" o) "exclusion-implementation" f "")) :ruleset closure)
(rule ((coverage id s p o expected))
      ((set (implementation-fulfilled id) 0) (set (observed-match id) 0)) :ruleset closure)
(rule ((coverage id s p o expected) (observation s p o evidence))
      ((set (observed-match id) 1)) :ruleset closure)
(rule ((coverage id s p o "true") (observation s p o evidence))
      ((set (implementation-fulfilled id) 1) (implementation-satisfied id evidence)) :ruleset closure)
(rule ((implementation-mode) (coverage id s p o "false") (observation s p o evidence))
      ((violation "implementation-prohibition" id s evidence)
       (because (+ "violation|implementation-prohibition|" id "|" s) "observed-prohibited-behavior" id evidence)) :ruleset closure)
(rule ((coverage id s p o "false") (complete-scope s p o evidence) (= (observed-match id) 0))
      ((set (implementation-fulfilled id) 1) (implementation-satisfied id evidence)) :ruleset evidence-closure)
(rule ((coverage id s p o "false") (complete-scope s p "*" evidence) (= (observed-match id) 0))
      ((set (implementation-fulfilled id) 1) (implementation-satisfied id evidence)) :ruleset evidence-closure)

; Host-selected compiler/test checks are separate from model-authored Evidence.
(rule ((implementation-mode) (required-check id))
      ((obligation (+ "check|" id) id "check" id)
       (set (fulfilled (+ "check|" id)) 0)
       (because (+ "check|" id) "required-mechanical-check" id "")) :ruleset closure)
(rule ((obligation (+ "check|" id) id "check" id) (check-result id "true" evidence))
      ((set (fulfilled (+ "check|" id)) 1) (satisfied (+ "check|" id) evidence)) :ruleset closure)
(rule ((implementation-mode) (required-check id) (check-result id "false" evidence))
      ((violation "failed-mechanical-check" id id evidence)
       (because (+ "violation|failed-mechanical-check|" id "|" id) "failed-mechanical-check" evidence "")) :ruleset closure)

; Relationship entities lower to n-ary weighted edges. Nonnegative costs are
; validated at ingestion; minimum merge makes positive dependency cycles finite.
(rule ((kind d "Dependency" _ k) (edge d "from" a f) (edge d "to" b g) (number d "cost" cost h))
      ((set (distance a b) cost)
       (because (+ "distance|" a "|" b) "dependency-cost" f h)) :ruleset closure)
(rule ((= (distance a b) x) (= (distance b c) y))
      ((set (distance a c) (+ x y))
       (because (+ "distance|" a "|" c) "path-cost" (+ "distance|" a "|" b) (+ "distance|" b "|" c))) :ruleset closure)
(rule ((number a "risk" r f)) ((set (peak-risk a) r)) :ruleset closure)
(rule ((reachable a b f) (= (peak-risk b) r)) ((set (peak-risk a) r)) :ruleset closure)
(rule ((number a "latencyBudgetMs" budget f) (number a "latencyMs" actual g) (> actual budget))
      ((violation "latency-budget" a a f)
       (because (+ "violation|latency-budget|" a "|" a) "latency-budget" f g)) :ruleset closure)
(rule ((boolean a p x f) (boolean a p y g) (!= x y))
      ((violation "conflicting-boolean" a p f)
       (because (+ "violation|conflicting-boolean|" a "|" p) "functional-property" f g)) :ruleset closure)

; Structured relationship entities have one subject, predicate and target. Without
; these laws a single contract id could share a satisfaction lattice across two
; different propositions, and one matching alternative could hide a missing one.
(relation contract-endpoint (String))
(contract-endpoint "from")
(contract-endpoint "target")
(rule ((contract-kind c) (contract-endpoint p) (edge c p a f) (edge c p b g) (!= a b))
      ((violation "conflicting-contract-shape" c p f)
       (because (+ "violation|conflicting-contract-shape|" c "|" p) "single-contract-endpoint" f g)) :ruleset closure)
(rule ((contract-kind c) (text c "relation" a f) (text c "relation" b g) (!= a b))
      ((violation "conflicting-contract-shape" c "relation" f)
       (because (+ "violation|conflicting-contract-shape|" c "|relation") "single-contract-relation" f g)) :ruleset closure)
(relation dependency-endpoint (String))
(dependency-endpoint "from")
(dependency-endpoint "to")
(rule ((kind d "Dependency" _ k) (dependency-endpoint p) (edge d p a f) (edge d p b g) (!= a b))
      ((violation "conflicting-dependency-shape" d p f)
       (because (+ "violation|conflicting-dependency-shape|" d "|" p) "single-dependency-endpoint" f g)) :ruleset closure)
(rule ((number s p a f) (number s p b g) (!= a b))
      ((violation "conflicting-number" s p f)
       (because (+ "violation|conflicting-number|" s "|" p) "single-numeric-property" f g)) :ruleset closure)

; Observe zero only after the satisfaction lattice has reached its fixed point.
(rule ((obligation id s p o) (= (fulfilled id) 0))
      ((unresolved id s p o)) :ruleset diagnostics)
(rule ((= (distance a b) cost)) ((path-cost a b cost)) :ruleset diagnostics)
(rule ((= (peak-risk a) risk)) ((risk-score a risk)) :ruleset diagnostics)
(rule ((implementation-mode) (coverage id s p o expected) (= (implementation-fulfilled id) 0))
      ((unresolved (+ "implementation|" id) s p o)
       (because (+ "implementation|" id) "required-implementation-evidence" id "")) :ruleset diagnostics)
