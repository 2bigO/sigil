{
  "name": "@qoherent/sigil-compiler",
  "version": "0.7.1",
  "exports": "./src/mod.ts",
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "n3-types": "npm:@types/n3@1.26.0",
    "n3": "npm:n3@1.26.0"
  },
  "publish": {
    "include": [
      "README.md",
      "LICENSE",
      "src/**/*.ts",
      "skills/**/*.md",
      "skills/**/compile.json"
    ],
    "exclude": [
      "tests/"
    ]
  },
  "tasks": {
    "test": "deno test --allow-read --allow-write --allow-run",
    "publish:dry-run": "deno publish --dry-run"
  },
  "compilerOptions": {
    "strict": true
  }
}
