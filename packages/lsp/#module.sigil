@spec/language.sigil import { SigilLanguage, SigilWorkspaceConfig }
@spec/glossary.sigil import { SigilWorkspaceGlossary }
@packages/core import { SigilCore }

component SigilLsp {
  goal {
    Provide editor-neutral Sigil language intelligence through Language Server Protocol.

    Reuse deterministic core semantics without depending on VS Code APIs or agent-host behavior.
  }

  interface {
    LspPackage {
      provides importable server APIs and an executable standard-input/output entrypoint declared by packages/lsp/deno.json
    }

    ProtocolSession {
      implements Language Server Protocol 3.18 over JSON-RPC standard input and standard output

      supports initialize, initialized, shutdown, and exit lifecycle messages

      uses UTF-16 positions

      rejects requests received before initialization
    }

    DocumentSynchronization {
      supports textDocument/didOpen, textDocument/didChange, and textDocument/didClose with full-document synchronization

      open-document content overrides filesystem content until close
    }

    DiagnosticPublishing {
      publishes structural and workspace diagnostics through textDocument/publishDiagnostics
    }

    NavigationAndInspection {
      supports hierarchical document symbols for components, expands, and sections

      supports definition navigation for imports, component declarations, expand declarations, and resolved component references

      supports hover for component contracts and collected expansions

      hover for a component contract presents implementation targets discovered from source and agent-facing Markdown comments as clickable links to their originating artifacts

      supports full-document semantic tokens for resolved component names

      every hover renders resolver-confirmed component and concept references in displayed Sigil semantic lines as inline links to their originating declarations
    }

    ConceptLanguageFeatures {
      supports document symbols, definition, hover, diagnostics, and semantic highlighting for resolved concept identities

      hover on a reused concept presents its collective public interface occurrences from the origin through the current component context

      when a concept declaration or reference spelling matches an effective reviewed glossary term or alias in the hovered file's glossary context, hover presents the concept content together with the canonical term, definition, scope, and matched alias
    }

    GlossaryLanguageFeatures {
      supports hover, definition navigation, and semantic highlighting for resolved glossary occurrences
    }

    WorkspaceSupport {
      operates on file-backed workspaces selected from workspaceFolders, rootUri, or the current directory
    }

    ReadOnlyLanguageService {
      language-server operations do not modify .sigil source
    }
  }
}

expand SigilLsp {
  state {
    ProtocolSession {
      Server lifecycle is uninitialized, running, shutdown-requested, or exited.
    }

    DocumentSynchronization {
      Open documents retain URI, client version, and current in-memory text.
    }

    WorkspaceSupport {
      The initialized workspace starts from the first workspaceFolders entry, rootUri, or current directory.
    }
  }

  logic {
    ProtocolSession {
      initialize resolves the selected workspace, advertises implemented capabilities, and reports UTF-16 position encoding.

      shutdown completes outstanding work, returns null, and enters shutdown-requested state.

      exit succeeds only after shutdown.
    }

    DocumentSynchronization {
      didOpen and didChange parse in-memory content and publish updated diagnostics.

      didClose removes the overlay and republishes diagnostics from the filesystem source when available.

      Workspace operations prefer open-document overlays.
    }

    NavigationAndInspection {
      Definition maps core source ranges to declaration locations.

      Hover presents core contract and expansion projections without inventing semantics.

      Definition, hover, and semantic-token classification share one component-reference resolver.

      Hover derives inline navigation targets from the shared component and concept reference resolvers and encodes them as file-URI Markdown links to declaration identifier ranges.

      Hover supplies supported workspace implementation sources to the shared core ownership query and renders resolved targets as standard Markdown links.

      Hover does not cache owned implementation targets.

      Document symbols preserve declaration and section hierarchy.
    }

    ConceptLanguageFeatures {
      Concept features consume core namespace identities, occurrences, and references while preserving imported-concept origin.

      Definition and hover include contextual occurrences for the selected component without adding consumer content upstream.

      Definition, hover, and semantic highlighting do not independently reinterpret semantic text as concept references.

      Concept hover combines originating public interface occurrences with public contextual reuse occurrences available through the current component's import path.

      Hover preserves each occurrence's component, section, and source attribution.
    }

    GlossaryLanguageFeatures {
      Glossary features consume core glossary occurrences without independently scanning prose.

      Hover presents canonical spelling, definition, context, and matched alias.

      Concept declaration and reference hover matches the identifier spelling against the hovered file's effective glossary entries without creating a glossary occurrence.

      When a concept declaration or reference matches an effective glossary entry, Hover appends glossary Markdown after concept Markdown in one response.

      Definition targets the canonical term declaration in GlossaryFile.

      Semantic tokens classify resolved occurrences with the term token type.
    }
  }

  constraints {
    ArtifactVersionOwnership {
      packages/lsp/deno.json owns the LSP artifact version.

      The LSP Sigil contract does not claim package-registry publication or duplicate a manifest version.
    }

    ProtocolSession {
      Standard output contains protocol messages only and logging uses standard error.

      Every advertised position uses UTF-16 code units.

      Malformed requests return protocol errors without terminating the server.
    }

    NavigationAndInspection {
      Semantic highlighting uses standard full-document responses and distinguishes component and concept tokens from free text.

      Client cancellation prevents an obsolete result when cancellation is observed before completion.

      Hover navigation uses standard LSP Markdown links without command URIs, trusted command execution, or custom protocol methods.

      Only resolver-confirmed component and concept references become links; unresolved identifiers and ordinary prose remain unchanged.

      Owned implementation hover links point to the originating artifact location and remain standard Markdown links.
    }

    ConceptLanguageFeatures {
      Imported-concept hover does not expose private state, logic, constraints, decisions, cases, or expansion occurrences.
    }

    GlossaryLanguageFeatures {
      Glossary occurrence features apply only to free-form prose in loaded .sigil documents.

      The semantic-token legend includes term and preserves non-overlapping UTF-16 ranges.

      The server does not infer unknown terms or modify GlossaryFile.

      Concept identifiers remain structural syntax and do not become glossary occurrences, term semantic tokens, or GlossaryFile definition targets.

      Definition navigation on a concept declaration or reference targets the concept origin even when its spelling matches an effective glossary entry.

      Combined hover does not change semantic-token overlap resolution.
    }

    WorkspaceSupport {
      Transport and workspace access support standard input/output and file URIs only.
    }

    DependencyDirection {
      SigilLsp consumes SigilCore parsing, workspace, resolution, graph, projection, and diagnostic facts.

      SigilLsp does not duplicate core semantics and does not depend on VS Code or agent-host APIs.
    }

    ReadOnlyLanguageService {
      The server produces diagnostics and language-feature results but no workspace edits, text edits, file creation, deletion, or rename operations.
    }
  }

  decisions {
    ProtocolSession {
      Decision: Use Language Server Protocol 3.18 over JSON-RPC standard input and output with UTF-16 positions and full-document synchronization.

      Scope: Governs protocol transport, lifecycle, position encoding, and document synchronization; excludes editor-specific user interfaces.

      Trade-offs: Full-document synchronization is simpler and deterministic but may transfer more text than incremental synchronization.

      Consequences: Editors can reuse standard lifecycle, diagnostics, navigation, hover, and semantic-token behavior.

      Revisit when: Large-document evidence requires incremental synchronization or a supported non-stdio host becomes necessary.
    }

    NavigationAndInspection {
      Decision: Surface implementation-comment-linked targets in contract hover as clickable Markdown links.

      Scope: Governs SigilLsp hover, supported workspace implementation-source scanning, and the shared core ownership query result; excludes persistence and caching.

      Trade-offs: Reusing the shared core query keeps CLI and LSP aligned, but on-demand source scanning adds hover lookup cost.

      Consequences: Users can navigate from a contract to entrypoints and agent-facing Markdown that explicitly link back to it.

      Revisit when: Hover latency or request volume requires indexed ownership annotations.
    }
  }

  cases {
    DocumentSynchronization {
      Opening or changing malformed in-memory source publishes ranged diagnostics.

      Fixing the source clears diagnostics that no longer apply.

      Closing an overlay restores filesystem-derived diagnostics.
    }

    NavigationAndInspection {
      Definition on an imported component opens its original declaration.

      Definition on an expand opens its matching component.

      Hover exposes the public contract and every collected expansion source.

      Unmatched capitalized prose remains ordinary text.

      Component-contract and collected-expansion hovers link displayed component and concept references to their origins.

      Component-contract hover also lists owned implementation targets as clickable links when the contract declares them.

      A displayed name without a resolved component or concept identity remains plain hover text.
    }

    ConceptLanguageFeatures {
      An imported concept navigates to its originating declaration.

      A resolved whole-word concept receives highlighting, definition, and hover.

      Hovering a reused imported concept shows both its originating interface content and the consumer's public contextual content.

      Hovering a reused imported concept does not reveal the provider's private collective expansion content.

      Concept hover links displayed references to other concepts and components while preserving the existing visibility rules for imported concepts.

      Ungrouped interface content receives one warning per contiguous region.

      A valid nonpreferred identifier produces a hint.
    }

    GlossaryLanguageFeatures {
      Hovering an alias displays its canonical term and reviewed definition.

      Definition on a recognized occurrence opens its GlossaryFile entry.

      A recognized term receives highlighting while the same spelling inside inline code does not.

      Hovering a concept declaration or reference whose identifier matches a canonical glossary term or alias shows concept details followed by reviewed glossary details.

      Go to Definition on that concept opens the originating concept declaration rather than GlossaryFile.
    }

    WorkspaceSupport {
      Invalid workspace configuration is reported without crashing the server.
    }

    ProtocolSession {
      Shutdown followed by exit succeeds.
    }
  }
}
