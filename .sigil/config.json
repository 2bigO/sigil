{
  "sigilVersion": "0.6.0",
  "workspace": {
    "name": "sigil",
    "members": [
      "packages/cli",
      "packages/compiler",
      "packages/core",
      "packages/lsp",
      "integrations/skills/sigil",
      "integrations/editor/vscode"
    ]
  },
  "files": {
    "include": [
      "**/*.sigil"
    ],
    "exclude": [
      ".git/**",
      ".deno/**",
      "node_modules/**",
      "build/**",
      "coverage/**",
      "examples/**"
    ]
  },
  "tools": {
    "compile": {
      "defaultProfile": "standard",
      "budgets": {
        "maxCommandOutputChars": 3000000,
        "maxInputTokens": 1000000
      },
      "adapter": {
        "provider": "codex"
      }
    }
  }
}
