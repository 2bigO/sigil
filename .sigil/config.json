{
  "sigilVersion": "0.7.0",
  "workspace": {
    "name": "sigil",
    "members": [
      "packages/cli",
      "packages/compiler",
      "packages/compiler-adapter-opencode",
      "packages/compiler-adapter-pi",
      "packages/compiler-adapter-claude",
      "packages/core",
      "packages/lsp",
      "integrations/skills/sigil",
      "integrations/editor/vscode"
    ]
  },
  "files": {
    "include": [
      "**/*.sigil"
    ],
    "exclude": [
      ".git/**",
      ".deno/**",
      "node_modules/**",
      "build/**",
      "coverage/**",
      "examples/**"
    ]
  },
  "tools": {
    "agent": {
      "profile": "claude"
    },
    "compile": {
      "defaultProfile": "standard",
      "budgets": {
        "elapsedTimeMs": 3000000,
        "maxCommands": 512,
        "maxCommandOutputChars": 3000000,
        "maxInputTokens": 4000000,
        "maxOutputTokens": 4000000
      },
      "limits": {
        "maxCompilationRequestChars": 2000000,
        "maxAgentInputChars": 2000000,
        "sessionTtlMs": 86400000
      },
      "profiles": {
        "standard": {
          "main": ["codex"]
        },
        "claude": {
          "extends": "standard",
          "main": ["claude"]
        }
      },
      "evaluators": {
        "codex": {
          "provider": "codex",
          "implementationId": "builtin.codex-cli",
          "implementationVersion": "0.7.1"
        },
        "claude": {
          "provider": "claude",
          "implementationId": "builtin.claude-cli",
          "implementationVersion": "0.7.1"
        }
      }
    }
  }
}
