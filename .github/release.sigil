@packages/cli import { SigilCli }
@packages/cli/src/installer.sigil import { SkillInstaller }
@integrations/editor/vscode import { SigilVsCodeExtension }

component SigilReleaseDistribution {
  goal {
    Distribute native Sigil CLI archives, bundled agent skills, and an installable VS Code extension through GitHub Releases.

    Let users install released artifacts without first installing Deno, Node.js, or a package-registry client.
  }

  interface {
    NativeCliRelease {
      a cli-vX.Y.Z GitHub Release provides native CLI archives for supported macOS, Linux, and Windows targets

      each archive contains one native executable and its version-matched skill catalog

      install.sh installs the latest or explicitly selected macOS or Linux CLI release

      install.ps1 installs the latest or explicitly selected Windows CLI release

      SIGIL_VERSION selects an explicit CLI release version in both installers
    }

    VsCodeRelease {
      a vscode-vX.Y.Z GitHub Release provides one installable VSIX
    }
  }
}

expand SigilReleaseDistribution {
  logic {
    NativeCliRelease {
      Validate that the release tag agrees with the CLI manifest before building assets.

      Compile x86_64 and ARM64 executables for macOS and Linux and x86_64 for Windows.

      Package stable platform-specific archive names containing versioned bin/sigil and integrations/skills paths.

      Detect host operating system and architecture before selecting an archive.

      Download the archive and checksum manifest from the same release.

      Verify SHA-256 before extracting or changing the active executable.

      Install into a versioned user-data directory and expose the selected executable through a user PATH directory.
    }

    VsCodeRelease {
      Run verification, build the bundled extension and language server, package one VSIX, and upload it as a release asset.
    }
  }

  constraints {
    ReleaseIntegrity {
      GitHub Release assets are the durable public binary distribution channel; workflow artifacts are build intermediates.

      A release tag must agree with the owning artifact manifest.

      Installation scripts fail without replacing the active version when download, checksum, or extraction fails.
    }

    NativeCliRelease {
      Installation scripts reject unsupported operating-system or architecture combinations.

      Default user-scoped installation requires no administrator privileges.

      Pre-production native executables may remain unsigned and release documentation identifies that limitation.

      Future signing must preserve archive names and installer commands.
    }

    VsCodeRelease {
      The VSIX is distributed through GitHub Releases and not through an extension marketplace.
    }
  }

  cases {
    NativeCliRelease {
      Apple Silicon macOS and supported Linux users install matching native archives without Deno.

      SIGIL_VERSION selects the requested release.

      Windows installation requires no developer-mode symlink privilege.

      A checksum mismatch leaves the previously active executable unchanged.

      An unsupported platform fails without downloading an unrelated executable.
    }

    VsCodeRelease {
      A user downloads the VSIX from GitHub Releases and installs it through VS Code Install from VSIX.
    }
  }
}
