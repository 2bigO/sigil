@spec/language.sigil import { SigilLanguage, SigilWorkspaceConfig, SigilModuleIndex }
@packages/core import { SigilCore }
@packages/cli import { SigilCli }
@packages/lsp import { SigilLsp }
@integrations/editor/vscode import { SigilVsCodeExtension }
@integrations/skills/sigil import { SigilSkill }

component Sigil {
  goal {
    Enable humans and coding agents to preserve, inspect, and evolve software rationale through one versioned language and toolchain.

    Keep deterministic language facts separate from host-assisted semantic judgment and explicit human approval.
  }

  interface {
    ComponentContract {
      lets humans and coding agents share durable public contracts and operational rationale for coherent software parts
    }

    WorkspaceBoundary {
      lets tools select a configured workspace and discover its included Sigil sources consistently
    }

    DirectoryImportSurface {
      lets authors use intentional directory-import shorthand
    }

    ComponentVisibility {
      keeps every component importable through its explicit Sigil source path regardless of directory-import shorthand
    }

    ToolchainSurfaces {
      provides non-interactive command-line automation, editor-neutral language intelligence, and a VS Code authoring surface

      keeps command-line and language-server operations from modifying .sigil source
    }

    HumanReviewWorkflow {
      provides a host-neutral agent workflow for design clarification, semantic review, explicit approval, and Sigil-guided implementation
    }
  }
}

expand Sigil {
  state {
    ReleaseMaturity {
      Sigil artifacts are pre-production.
    }
  }

  logic {
    DeterministicSemantics {
      Core computes parsing, configuration, workspace, resolution, graph, projection, and diagnostic facts shared by toolchain surfaces.
    }

    HumanReviewWorkflow {
      The host skill applies semantic judgment, conducts design and review conversations, and uses ReviewGate for scoped approval of Sigil changes and implementation.
    }
  }

  constraints {
    LanguageVersion {
      SigilLanguage owns the single language and workspace-configuration version literal.
    }

    ArtifactVersionOwnership {
      Package and integration manifests own distributable artifact versions; the root Sigil contract does not duplicate them.
    }

    ComponentContract {
      Public contracts live in components, operational rationale lives in matching expands, and trivial reconstructable mechanics need no separate component.
    }

    ConfigFile {
      ConfigFile is the sole authority for selecting a Sigil workspace root and its declared members.
    }

    ModuleIndexFile {
      ModuleIndexFile defines directory-import shorthand and has no workspace-discovery authority.
    }

    ToolchainSurfaces {
      CLI and LSP workspace operations report or project Sigil semantics without modifying .sigil source.
    }

    HumanReviewWorkflow {
      Host-assisted semantic judgment remains outside deterministic core packages.

      The review workflow remains host-neutral and requires explicit human approval before semantic Sigil edits or implementation.
    }

    ReleaseMaturity {
      Pre-production artifacts make no production-readiness or compatibility guarantee beyond their declared versioned contracts.
    }
  }

  cases {
    DeterministicSemantics {
      CLI and LSP consumers resolving the same configured workspace receive semantics derived from the same core contracts.
    }

    HumanReviewWorkflow {
      A material semantic change remains unedited until the exact Sigil proposal receives explicit human approval.
    }

    ArtifactVersionOwnership {
      Changing a distributable artifact version updates its owning manifest without requiring a duplicate root-contract version edit.
    }
  }
}
