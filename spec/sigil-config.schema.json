{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qoherent/sigil/blob/main/spec/sigil-config.schema.json",
  "title": "Sigil workspace configuration",
  "type": "object",
  "$defs": {
    "glob": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "member": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\.$)(?!/)(?![A-Za-z]:[\\\\/])(?!.*\\\\)(?!\\./)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\/$).+$"
    }
  },
  "additionalProperties": false,
  "required": ["sigilVersion", "workspace", "files"],
  "properties": {
    "sigilVersion": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "members": {
          "type": "array",
          "items": { "$ref": "#/$defs/member" },
          "uniqueItems": true,
          "default": []
        }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include"],
      "properties": {
        "include": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/glob" },
          "default": ["**/*.sigil"]
        },
        "exclude": {
          "type": "array",
          "items": { "$ref": "#/$defs/glob" },
          "default": [
            ".git/**",
            ".deno/**",
            "node_modules/**",
            "build/**",
            "coverage/**"
          ]
        }
      }
    },
    "tools": {
      "type": "object",
      "propertyNames": { "minLength": 1 },
      "properties": {
        "semantic": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "providers"],
          "properties": {
            "version": { "const": 1 },
            "defaultProvider": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            },
            "proposalTimeoutMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "providers": {
              "type": "object",
              "propertyNames": { "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind"],
                    "properties": {
                      "kind": { "enum": ["codex", "claude", "pi", "opencode"] },
                      "model": { "type": "string", "minLength": 1 }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "command"],
                    "properties": {
                      "kind": { "const": "command" },
                      "command": { "type": "string", "minLength": 1 },
                      "args": { "type": "array", "items": { "type": "string" } }
                    }
                  }
                ]
              }
            }
          }
        }
      },
      "additionalProperties": { "type": "object" },
      "default": {}
    }
  }
}
